/* ───────────────────────────────────────────────────────────
   Game Systems 디자인 시스템
   다크 테마 · 포인트 컬러 1개 · 보일 듯 말 듯한 외곽선 · 넉넉한 여백
   ─────────────────────────────────────────────────────────── */

.gs-root {
    --gs-bg: #0E0F11;
    --gs-surface: #16171A;
    --gs-surface-2: #1D1E22;
    --gs-surface-hover: #1F2024;
    --gs-border: rgba(255, 255, 255, 0.06);
    --gs-border-strong: rgba(255, 255, 255, 0.13);
    --gs-hover: rgba(255, 255, 255, 0.04);
    --gs-text: #F2F2F3;
    --gs-text-2: rgba(242, 242, 243, 0.62);
    --gs-text-3: rgba(242, 242, 243, 0.36);
    --gs-accent: #FD5D83;
    --gs-accent-hover: #FF7899;
    --gs-accent-soft: rgba(253, 93, 131, 0.14);
    --gs-danger: #FB9795;
    --gs-success: #71D6A3;
    --gs-warning: #E8D66B;

    flex-grow: 1;
    background-color: var(--gs-bg);
    color: var(--gs-text);
    font-size: 12px;
}

/* 기본 Label 여백 제거 — 간격은 레이아웃이 책임진다 */
.gs-root Label {
    color: var(--gs-text);
    margin: 0;
    padding: 0;
    white-space: normal;
}

/* ── 글자 위계 ─────────────────────────────────────────── */
.gs-root .gs-display { font-size: 22px; -unity-font-style: bold; }
.gs-root .gs-title { font-size: 15px; -unity-font-style: bold; }
.gs-root .gs-heading { font-size: 13px; -unity-font-style: bold; }
.gs-root .gs-body { font-size: 12px; }
.gs-root .gs-text-2 { color: var(--gs-text-2); }
.gs-root .gs-text-3 { color: var(--gs-text-3); }
.gs-root .gs-caption { font-size: 11px; color: var(--gs-text-3); }
.gs-root .gs-mono { -unity-font-style: normal; letter-spacing: 0.2px; }
.gs-root .gs-accent-text { color: var(--gs-accent); }
.gs-root .gs-nowrap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── 레이아웃 도우미 ───────────────────────────────────── */
.gs-row { flex-direction: row; align-items: center; }
.gs-col { flex-direction: column; }
.gs-grow { flex-grow: 1; flex-shrink: 1; }
.gs-wrap { flex-wrap: wrap; }
.gs-gap-s > * { margin-right: 6px; }
.gs-gap > * { margin-right: 12px; }
.gs-spacer { flex-grow: 1; }

/* ── 패널 ─────────────────────────────────────────────── */
.gs-panel {
    background-color: var(--gs-surface);
    border-width: 1px;
    border-color: var(--gs-border);
    border-radius: 14px;
    padding: 20px;
}

.gs-panel__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.gs-divider {
    height: 1px;
    background-color: var(--gs-border);
    margin: 12px 0;
}

/* ── 버튼 (Unity 기본 버튼 모양을 쓰지 않는 자체 버튼) ──── */
.gs-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    border-radius: 9px;
    background-color: var(--gs-surface-2);
    border-width: 1px;
    border-color: var(--gs-border);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.14s, 0.14s, 0.12s;
    transition-timing-function: ease-out-cubic;
    cursor: link;
}
.gs-button:hover { background-color: #25262B; border-color: var(--gs-border-strong); }
.gs-button:active { scale: 0.97 0.97; }
.gs-button Label { font-size: 12px; }

.gs-button--primary { background-color: var(--gs-accent); border-color: var(--gs-accent); }
.gs-button--primary:hover { background-color: var(--gs-accent-hover); border-color: var(--gs-accent-hover); }
.gs-root .gs-button--primary Label { color: #FFFFFF; -unity-font-style: bold; }

/* 평소엔 글자처럼 보이는 버튼 — 정보 우선 원칙 */
.gs-button--ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); padding: 5px 8px; }
.gs-button--ghost:hover { background-color: var(--gs-hover); border-color: rgba(0, 0, 0, 0); }
.gs-root .gs-button--ghost Label { color: var(--gs-text-3); }
.gs-root .gs-button--ghost:hover Label { color: var(--gs-text); }

.gs-button:disabled { opacity: 0.4; }

/* ── 분할 선택(보기 전환 등) ───────────────────────────── */
.gs-segmented {
    flex-direction: row;
    padding: 3px;
    border-radius: 10px;
    background-color: var(--gs-surface);
    border-width: 1px;
    border-color: var(--gs-border);
}
.gs-segmented__item {
    padding: 5px 12px;
    border-radius: 7px;
    transition-property: background-color;
    transition-duration: 0.14s;
    cursor: link;
}
.gs-root .gs-segmented__item Label { color: var(--gs-text-3); font-size: 11px; }
.gs-segmented__item:hover { background-color: var(--gs-hover); }
.gs-root .gs-segmented__item:hover Label { color: var(--gs-text-2); }
.gs-segmented__item--active { background-color: var(--gs-surface-2); }
/* 굵기를 바꾸면 글자 폭이 달라져 전체 폭이 흔들린다 → 색과 배경만 바꾼다 */
.gs-root .gs-segmented__item--active Label { color: var(--gs-text); }

/* ── 배지 (색은 분류 팔레트에서 코드로 지정) ──────────── */
.gs-badge {
    padding: 2px 8px;
    border-radius: 6px;
    margin-right: 6px;
    flex-shrink: 0;
}
.gs-root .gs-badge Label { font-size: 10px; -unity-font-style: bold; }

/* ── 검색창 ───────────────────────────────────────────── */
.gs-search {
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    height: 34px;
    border-radius: 10px;
    background-color: var(--gs-surface);
    border-width: 1px;
    border-color: var(--gs-border);
    transition-property: border-color;
    transition-duration: 0.15s;
}
.gs-search--focused { border-color: var(--gs-border-strong); }
.gs-search__icon { width: 8px; height: 8px; border-radius: 5px; border-width: 1.5px; border-color: var(--gs-text-3); margin-right: 10px; }
.gs-search .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--gs-text);
    padding: 0;
    font-size: 12px;
}
.gs-search TextField { flex-grow: 1; margin: 0; }
.gs-search__placeholder { position: absolute; left: 30px; }

/* ── 진행 바 ──────────────────────────────────────────── */
.gs-progress {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.07);
    overflow: hidden;
}
.gs-progress__fill {
    height: 100%;
    border-radius: 3px;
    background-color: var(--gs-accent);
    transition-property: width;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}
.gs-progress--done .gs-progress__fill { background-color: var(--gs-success); }

/* ── 카드 ─────────────────────────────────────────────── */
.gs-card {
    background-color: var(--gs-surface);
    border-width: 1px;
    border-color: var(--gs-border);
    border-radius: 14px;
    overflow: hidden;
    margin: 0 14px 14px 0;
    transition-property: translate, border-color, background-color;
    transition-duration: 0.18s, 0.18s, 0.18s;
    transition-timing-function: ease-out-cubic;
}
.gs-card:hover { translate: 0 -2px; border-color: var(--gs-border-strong); background-color: var(--gs-surface-hover); }
.gs-card--selected { border-color: var(--gs-accent); }
.gs-card--selected:hover { border-color: var(--gs-accent); }

.gs-card__media {
    background-color: var(--gs-surface-2);
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
}
.gs-card__media-empty { flex-grow: 1; align-items: center; justify-content: center; }
.gs-card__body { padding: 14px 16px 16px 16px; flex-grow: 1; flex-shrink: 1; }
.gs-root .gs-card__title { font-size: 14px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gs-root .gs-card__subtitle { font-size: 11px; color: var(--gs-text-3); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gs-card__badges { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.gs-card__stats { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.gs-card__stat { margin-right: 16px; }
.gs-root .gs-card__stat-label { font-size: 10px; color: var(--gs-text-3); }
.gs-root .gs-card__stat-value { font-size: 13px; margin-top: 1px; }

/* A. 세로형: 정사각형 이미지가 위를 채움 (카드 폭 200 = 테두리 2 + 이미지 198) */
.gs-card--vertical { width: 200px; height: 320px; flex-direction: column; }
.gs-card--vertical .gs-card__media { height: 198px; }

/* B. 가로형: 16:9 카드, 정사각형 이미지가 왼쪽을 채움 (카드 높이 216 = 테두리 2 + 이미지 214) */
.gs-card--horizontal { width: 384px; height: 216px; flex-direction: row; }
.gs-card--horizontal .gs-card__media { width: 214px; height: 100%; }
.gs-card--horizontal .gs-card__body { padding: 18px 20px; }

/* C. 바형: 이미지 상·하·좌 여백을 10으로 같게 (높이 66 = 테두리 2 + 여백 10 + 이미지 44 + 여백 10) */
.gs-card--bar { height: 66px; flex-direction: row; align-items: center; padding: 0 14px 0 10px; margin: 0 0 8px 0; border-radius: 14px; }
.gs-card--bar:hover { translate: 0 0; }
.gs-card--bar .gs-card__media { width: 44px; height: 44px; border-radius: 10px; }
.gs-card--bar .gs-card__body { padding: 0 0 0 12px; flex-direction: row; align-items: center; }
.gs-card--bar .gs-card__badges { margin-top: 0; margin-left: 10px; }
.gs-card--bar .gs-card__stats { margin-top: 0; }

/* ── 인라인 값(평소엔 글자, 클릭하면 편집) ───────────── */
.gs-inline {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 3px 8px;
    margin-left: -8px;
    border-radius: 6px;
    transition-property: background-color;
    transition-duration: 0.12s;
}
.gs-inline--editable { cursor: link; }
.gs-inline--editable:hover { background-color: var(--gs-hover); }
.gs-root .gs-inline__value { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gs-root .gs-inline__empty { color: var(--gs-text-3); }
.gs-inline--editing { background-color: var(--gs-surface-2); }
.gs-inline--broken { background-color: rgba(251, 151, 149, 0.10); }
.gs-root .gs-inline--broken .gs-inline__value { color: var(--gs-danger); }

/* 편집 중에 나타나는 Unity 입력 필드를 테마에 맞춘다 */
.gs-inline .unity-base-field { margin: 0; flex-grow: 1; }
.gs-inline .unity-base-text-field__input,
.gs-inline .unity-object-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--gs-text);
    padding: 0;
    font-size: 12px;
}
.gs-inline .unity-base-field__label { display: none; }

/* ── 시트 ─────────────────────────────────────────────── */
.gs-sheet__header {
    flex-direction: row;
    padding: 0 12px 10px 12px;
    border-bottom-width: 1px;
    border-color: var(--gs-border);
}
.gs-root .gs-sheet__header Label { font-size: 10px; color: var(--gs-text-3); -unity-font-style: bold; letter-spacing: 0.4px; }
.gs-sheet__row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.035);
    transition-property: background-color;
    transition-duration: 0.12s;
}
.gs-sheet__row:hover { background-color: rgba(255, 255, 255, 0.022); }
.gs-sheet__row--selected { background-color: var(--gs-accent-soft); }
.gs-sheet__row--selected:hover { background-color: var(--gs-accent-soft); }
.gs-sheet__cell { padding-right: 14px; flex-shrink: 0; overflow: hidden; }
.gs-sheet__thumb { width: 26px; height: 26px; border-radius: 6px; background-color: var(--gs-surface-2); -unity-background-scale-mode: scale-and-crop; }

/* ── 사이드바 ─────────────────────────────────────────── */
.gs-sidebar {
    width: 228px;
    flex-shrink: 0;
    padding: 20px 14px;
    background-color: var(--gs-surface);
    border-right-width: 1px;
    border-color: var(--gs-border);
}
.gs-root .gs-sidebar__group { font-size: 10px; color: var(--gs-text-3); -unity-font-style: bold; letter-spacing: 0.6px; margin: 18px 0 6px 12px; }
.gs-nav-item {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    border-radius: 10px;
    margin-bottom: 2px;
    transition-property: background-color;
    transition-duration: 0.14s;
    cursor: link;
}
.gs-nav-item:hover { background-color: var(--gs-hover); }
.gs-root .gs-nav-item Label { color: var(--gs-text-2); }
.gs-root .gs-nav-item:hover Label { color: var(--gs-text); }
.gs-nav-item--active { background-color: var(--gs-accent); }
.gs-nav-item--active:hover { background-color: var(--gs-accent-hover); }
.gs-root .gs-nav-item--active Label { color: #FFFFFF; -unity-font-style: bold; }
.gs-root .gs-nav-item__count { font-size: 10px; color: var(--gs-text-3); }
.gs-root .gs-nav-item--active .gs-nav-item__count { color: rgba(255, 255, 255, 0.75); }
.gs-nav-dot { width: 6px; height: 6px; border-radius: 3px; margin-right: 10px; }

/* ── 상태 표시 ────────────────────────────────────────── */
.gs-notice {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-radius: 10px;
    background-color: var(--gs-surface-2);
    margin-bottom: 8px;
}
.gs-notice--error { background-color: rgba(251, 151, 149, 0.10); }
.gs-notice--warning { background-color: rgba(232, 214, 107, 0.08); }
.gs-notice--ok { background-color: rgba(113, 214, 163, 0.08); }
.gs-root .gs-notice--error Label { color: var(--gs-danger); }
.gs-root .gs-notice--warning Label { color: var(--gs-warning); }
.gs-root .gs-notice--ok Label { color: var(--gs-success); }

.gs-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
}

/* ── 블록 편집기 ──────────────────────────────────────── */
.gs-block {
    padding: 12px 14px;
    border-radius: 12px;
    background-color: var(--gs-surface-2);
    border-width: 1px;
    border-color: var(--gs-border);
    margin-bottom: 8px;
}
.gs-block__header { flex-direction: row; align-items: center; margin-bottom: 6px; }
.gs-block__children { margin-top: 8px; padding-left: 16px; border-left-width: 1px; border-color: var(--gs-border-strong); }
.gs-block__remove { opacity: 0; transition-property: opacity; transition-duration: 0.12s; }
.gs-block:hover > .gs-block__header > .gs-block__remove { opacity: 1; }
.gs-root .gs-preview { font-size: 13px; color: var(--gs-text); padding: 12px 14px; border-radius: 10px; background-color: var(--gs-accent-soft); margin-bottom: 12px; }

.gs-field-row { flex-direction: row; align-items: center; min-height: 30px; }
.gs-root .gs-field-row__label { width: 96px; flex-shrink: 0; font-size: 11px; color: var(--gs-text-3); }

/* ── 모션 ─────────────────────────────────────────────── */
.gs-appear {
    transition-property: opacity, translate;
    transition-duration: 0.28s, 0.32s;
    transition-timing-function: ease-out-cubic;
}
.gs-appear--hidden { opacity: 0; translate: 0 10px; }

/* ── 타임라인(모니터) ─────────────────────────────────── */
.gs-log-row { flex-direction: row; align-items: center; height: 34px; padding: 0 12px; border-radius: 8px; }
.gs-log-row:hover { background-color: var(--gs-hover); }
.gs-log-row--chain { background-color: var(--gs-accent-soft); }
.gs-log-row--dim { opacity: 0.35; }
.gs-log-row__chevron { width: 18px; flex-shrink: 0; -unity-text-align: middle-center; color: var(--gs-text-2); font-size: 11px; }
.gs-log-row__chevron:hover { color: var(--gs-accent); }
.gs-log-row__count { margin-left: 12px; margin-right: 14px; flex-shrink: 0; }
.gs-log-row--root .gs-badge { opacity: 1; }

/* 스크롤바를 옅게 */
.gs-root .unity-scroller--vertical { width: 8px; }
.gs-root .unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.10); border-width: 0; border-radius: 4px; }
.gs-root .unity-scroller__low-button,
.gs-root .unity-scroller__high-button { display: none; }
.gs-root .unity-scroller__slider .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }

/* ── 패널 제목과 설명 사이 간격 ────────────────────────── */
.gs-root .gs-panel__caption { margin-top: 6px; }

/* ── 시트 셀: 읽기 전용, 칸보다 긴 글자는 끝을 흐리게 가림(더블클릭 → 상세 패널) ── */
.gs-cell { flex-direction: row; align-items: center; height: 44px; overflow: hidden; }
.gs-root .gs-cell__text { white-space: nowrap; overflow: hidden; flex-shrink: 1; }
.gs-cell__fade { position: absolute; right: 0; top: 0; bottom: 0; width: 48px; display: none; }
/* 머리줄 경계를 끌어 열 폭 조절 */
.gs-sheet__header .gs-sheet__cell { overflow: visible; }
.gs-sheet__resizer {
    position: absolute;
    right: 2px;
    top: -4px;
    bottom: 6px;
    width: 8px;
    border-right-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    cursor: resize-horizontal;
    transition-property: border-color;
    transition-duration: 0.12s;
}
.gs-sheet__resizer:hover { border-color: var(--gs-accent); }
/* ── 모달 ─────────────────────────────────────────────── */
.gs-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 4, 6, 0.62);
    transition-property: opacity;
    transition-duration: 0.18s;
}
.gs-modal--hidden { opacity: 0; }
.gs-modal__content {
    transition-property: scale, opacity;
    transition-duration: 0.22s, 0.18s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}
.gs-modal--hidden .gs-modal__content { scale: 0.96 0.96; opacity: 0; }

/* ── 상세 패널: 위 [이미지][제목·정보] / 아래 전체 폭 정보 / 맨 아래 버튼 ───── */
.gs-detail {
    flex-direction: column;
    background-color: var(--gs-surface);
    border-width: 1px;
    border-color: var(--gs-border-strong);
    border-radius: 16px;
    overflow: hidden;
}
/* 위·아래 영역은 줄어들지 않는다(줄어들면 경계선이 글자를 덮는다). 늘고 줄어드는 건 가운데 정보 영역뿐. */
.gs-detail__top { flex-direction: row; align-items: flex-start; flex-shrink: 0; padding: 24px 22px 22px 24px; border-bottom-width: 1px; border-color: var(--gs-border); }
.gs-detail__media {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
    margin-right: 22px;
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--gs-surface-2);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}
.gs-root .gs-detail__initial { font-size: 48px; -unity-font-style: bold; opacity: 0.35; }
.gs-detail__media-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.gs-root .gs-detail__media-hint Label { font-size: 11px; color: #FFFFFF; }
.gs-detail__media--editable:hover .gs-detail__media-hint { opacity: 1; }
/* 투명한 선택기: 선택 버튼을 이미지 전체에 펼친다 */
.gs-detail__picker { position: absolute; left: 0; top: 0; right: 0; bottom: 0; margin: 0; opacity: 0.001; }
.gs-detail__picker .unity-object-field__input { position: absolute; left: 0; top: 0; right: 0; bottom: 0; margin: 0; }
.gs-detail__picker .unity-object-field__selector { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; height: auto; margin: 0; }
.gs-detail__body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.gs-detail__footer { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 60px; padding: 0 22px 0 24px; border-top-width: 1px; border-color: var(--gs-border); }.gs-detail__section { margin-bottom: 18px; }
.gs-root .gs-detail__label { font-size: 10px; color: var(--gs-text-3); -unity-font-style: bold; letter-spacing: 0.5px; margin-bottom: 6px; }
.gs-detail__section--changed > .gs-detail__label { color: var(--gs-accent); }

/* ── 변경 표시: 위 [이전] · V 화살표 · 아래 [현재] (긴 내용도 줄바꿈되어 잘리지 않는다) ── */
.gs-change { flex-direction: column; align-items: stretch; }
.gs-change__box { padding: 6px 10px; border-radius: 7px; }
.gs-root .gs-change__box Label { white-space: normal; }
.gs-change__old { background-color: var(--gs-surface-2); }
.gs-root .gs-change__old Label { color: var(--gs-text-3); }
.gs-change__new { background-color: var(--gs-accent-soft); }
.gs-root .gs-change__new Label { color: var(--gs-text); }
/* V자 화살표: 오른쪽·아래 테두리만 있는 정사각형을 45도 돌린다(글꼴에 기대지 않음) */
.gs-change__chevron {
    width: 8px;
    height: 8px;
    margin: 2px 0 8px 14px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--gs-accent);
    rotate: 45deg;
}

/* 상세 패널 안에서는 긴 값도 줄바꿈해 전부 보여준다 */
.gs-root .gs-detail .gs-inline__value { white-space: normal; }

/* 값 칸과 이전 값 칸은 같은 크기·같은 글자 위치(바뀌어도 원래 자리의 글자가 움직이지 않는다) */
.gs-detail .gs-inline { margin-left: 0; padding: 6px 10px; min-height: 32px; border-radius: 7px; }
.gs-detail .gs-change__box { flex-direction: row; align-items: center; min-height: 32px; padding: 6px 10px; border-radius: 7px; }
.gs-detail__value { flex-direction: column; align-items: stretch; }
.gs-detail .gs-inline { flex-shrink: 1; min-width: 0; }
.gs-detail .gs-inline TextField { flex-shrink: 1; min-width: 0; }
.gs-change-row { padding: 10px 0; border-bottom-width: 1px; border-color: var(--gs-border); }

/* ── 확인 창 ──────────────────────────────────────────── */
.gs-dialog {
    width: 460px;
    padding: 24px 24px 18px 24px;
    background-color: var(--gs-surface);
    border-width: 1px;
    border-color: var(--gs-border-strong);
    border-radius: 16px;
}
.gs-dialog__buttons { flex-direction: row; justify-content: flex-end; margin-top: 20px; }
.gs-dialog__buttons > * { margin-left: 8px; }
/* ── 블록 문장: 겉패널 없이 한 줄, 단어는 외곽선 패널 ───────────── */
.gs-sentence { flex-direction: row; flex-wrap: wrap; align-items: center; }
.gs-root .gs-sentence__word { color: var(--gs-text-2); margin: 0 10px 0 2px; }
.gs-inline.gs-token,
.gs-detail .gs-inline.gs-token {
    margin: 3px 8px 3px 0;
    padding: 6px 12px;
    min-height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--gs-border-strong);
    background-color: rgba(0, 0, 0, 0);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}
.gs-inline.gs-token:hover { border-color: rgba(255, 255, 255, 0.28); background-color: var(--gs-hover); }
.gs-inline.gs-token.gs-inline--editing { border-color: var(--gs-accent); }
/* 주어(첫 단어)와 뒤 내용 사이는 더 띄운다 */
.gs-inline.gs-token.gs-token--subject,
.gs-detail .gs-inline.gs-token.gs-token--subject { margin-right: 20px; }
.gs-root .gs-token .gs-inline__value { color: var(--gs-text); white-space: nowrap; }

/* 문장 한 줄 = 블록 하나. 줄 사이는 간격으로만 나눈다. */
.gs-block-line { margin-bottom: 10px; }
.gs-block-line__row { flex-direction: row; align-items: center; }
.gs-block-group { margin-bottom: 12px; }
.gs-block-group > .gs-block__header { flex-direction: row; align-items: center; margin-bottom: 8px; }
.gs-block-group > .gs-block__children { margin-top: 0; }
.gs-block__action { opacity: 0; transition-property: opacity; transition-duration: 0.12s; }
.gs-block-line:hover > .gs-block-line__row > .gs-block__action,
.gs-block-group:hover > .gs-block__header > .gs-block__action { opacity: 1; }

/* ── 상세 패널 요약: [머리말] 내용 ──────────────────── */
.gs-summary { margin-top: 16px; }
.gs-summary__row { flex-direction: row; align-items: flex-start; margin-bottom: 8px; }
.gs-root .gs-summary__label {
    width: 44px;
    flex-shrink: 0;
    margin-right: 14px;
    padding-top: 1px;
    font-size: 11px;
    color: var(--gs-text-3);
    -unity-font-style: bold;
    letter-spacing: 0.4px;
}
.gs-root .gs-summary__text { flex-grow: 1; flex-shrink: 1; white-space: normal; color: var(--gs-text); }
/* ── 드롭다운 (검색·그룹·현재 값 표시) ─────────────────── */
.gs-dropdown-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.gs-dropdown {
    position: absolute;
    padding: 6px;
    border-radius: 12px;
    background-color: var(--gs-surface-2);
    border-width: 1px;
    border-color: var(--gs-border-strong);
    transition-property: opacity, translate;
    transition-duration: 0.12s, 0.14s;
    transition-timing-function: ease-out-cubic;
}
.gs-dropdown--hidden { opacity: 0; translate: 0 -4px; }
.gs-dropdown .gs-search { height: 30px; margin: 0 0 6px 0; background-color: var(--gs-surface); }
.gs-dropdown__list { max-height: 320px; }
.gs-root .gs-dropdown__group { font-size: 10px; color: var(--gs-text-3); -unity-font-style: bold; letter-spacing: 0.4px; margin: 8px 10px 4px 10px; }
.gs-dropdown__item {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    padding: 5px 10px 5px 6px;
    border-radius: 8px;
    cursor: link;
}
.gs-dropdown__item--active { background-color: rgba(255, 255, 255, 0.06); }
.gs-dropdown__item--disabled { opacity: 0.45; cursor: arrow; }
.gs-root .gs-dropdown__check { width: 18px; color: var(--gs-accent); -unity-font-style: bold; -unity-text-align: middle-center; }
.gs-root .gs-dropdown__label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gs-root .gs-dropdown__item--selected .gs-dropdown__label { color: var(--gs-accent); }
.gs-root .gs-dropdown__detail { font-size: 11px; color: var(--gs-text-3); margin-top: 2px; white-space: normal; }
.gs-root .gs-dropdown__caption { font-size: 11px; color: var(--gs-text-3); margin-left: 12px; flex-shrink: 0; }
.gs-root .gs-dropdown__empty { color: var(--gs-text-3); padding: 12px 10px; }
/* ── 작업 줄(모니터 본문 아래, 뒷패널 없음) ─────────── */
.gs-dock {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    min-height: 32px;
    margin-top: 12px;
    margin-bottom: 18px;
}
/* ── 폴더형 탐색기 ─────────────────────────────────────── */
.gs-explorer { flex-grow: 1; min-height: 240px; }
.gs-explorer-dialog { width: 640px; max-width: 90%; }
.gs-explorer-dialog .gs-explorer__list { max-height: 420px; }
.gs-explorer__toolbar { align-items: center; margin-bottom: 8px; }
.gs-explorer__crumbs { flex-wrap: wrap; align-items: center; margin-left: 6px; }
.gs-explorer__crumb { color: var(--gs-text-2); padding: 2px 6px; border-radius: 6px; }
.gs-explorer__crumb:hover { background-color: var(--gs-hover); color: var(--gs-text); }
.gs-explorer__crumb--current { color: var(--gs-text); -unity-font-style: bold; }
.gs-explorer__sep { color: var(--gs-text-3); margin: 0 2px; }
.gs-explorer__list { border-top-width: 1px; border-color: var(--gs-border); padding-top: 4px; }
.gs-explorer__row { flex-direction: row; align-items: center; height: 34px; padding: 0 10px; border-radius: 8px; }
.gs-explorer__row:hover { background-color: var(--gs-hover); }
.gs-explorer__folder { width: 14px; height: 11px; border-radius: 3px; border-top-left-radius: 1px; margin-right: 12px; flex-shrink: 0; }
.gs-explorer__file { width: 10px; height: 12px; border-radius: 2px; margin-right: 14px; margin-left: 2px; flex-shrink: 0; }
.gs-explorer__name { width: 180px; flex-shrink: 0; overflow: hidden; }
.gs-explorer__type { width: 150px; flex-shrink: 0; overflow: hidden; }
.gs-explorer__value { color: var(--gs-text-2); margin-left: 8px; }
.gs-explorer__chevron { color: var(--gs-text-3); margin-left: 8px; }
.gs-explorer__pick { opacity: 0; margin-left: 8px; }
.gs-explorer__row:hover .gs-explorer__pick { opacity: 1; }
.gs-explorer__empty { padding: 16px 10px; }
/* ── 조건 묶음 접기 ── */
.gs-block__chevron { width: 14px; color: var(--gs-text-2); font-size: 11px; }
.gs-block-group > .gs-block__header:hover .gs-block__chevron { color: var(--gs-accent); }
.gs-block__summary { margin-left: 12px; flex-shrink: 1; overflow: hidden; }

/* ── 데이터 보기(그리드 + 블록) ─────────────────────────── */
.gs-view { flex-shrink: 0; }
.gs-view__tools { flex-direction: row; margin-bottom: 4px; }
.gs-view__tools .gs-button { opacity: 0.55; }
.gs-view__tools .gs-button:hover { opacity: 1; }
.gs-view__row { flex-direction: row; align-items: flex-start; margin-bottom: 12px; }
.gs-view__cell { padding-right: 16px; flex-shrink: 0; }
.gs-view__image-grid { flex-direction: row; flex-wrap: wrap; }
.gs-view__image-tile { padding: 0 10px 12px 0; }
.gs-view__image { height: 104px; border-radius: 12px; border-width: 1px; border-color: var(--gs-border); background-color: var(--gs-surface-2); -unity-background-scale-mode: scale-to-fit; justify-content: center; align-items: center; }
.gs-view__image--large { height: 220px; }
.gs-view__image:hover { border-color: var(--gs-accent); }
.gs-view__image-empty { color: var(--gs-text-3); }
.gs-view__image-label { margin-top: 6px; }
.gs-view__data { }
.gs-view__card { background-color: var(--gs-surface-2); border-width: 1px; border-color: var(--gs-border); border-radius: 12px; padding: 12px 14px; }
.gs-view__card-title { -unity-font-style: bold; margin-bottom: 8px; }
.gs-view__card-value { font-size: 16px; margin-top: 4px; }
.gs-view__card-row { flex-direction: row; align-items: center; min-height: 26px; }
.gs-view__card-key { width: 96px; flex-shrink: 0; }

/* ── 배치 편집 ── */
.gs-layout-editor { width: 1000px; max-width: 94%; height: 640px; max-height: 92%; }
.gs-layout-editor__list { width: 380px; flex-shrink: 0; margin-right: 16px; }
.gs-layout-editor__preview { flex-grow: 1; border-left-width: 1px; border-color: var(--gs-border); padding-left: 16px; }
.gs-layout-editor__row { margin-bottom: 10px; }
.gs-layout-editor__stepper { flex-direction: row; align-items: center; margin-right: 12px; margin-bottom: 6px; }
.gs-layout-editor__number { min-width: 22px; -unity-text-align: middle-center; }