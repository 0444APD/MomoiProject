/* 6.3+ USS 필터 시험용. 에디터 창에서 동작하는지 UI 샘플 창의 "필터 실험"에서 확인한다.
   이 파일이 해석되지 않아도 기본 테마(GsTheme.uss)에는 영향이 없다. */

.gs-exp-blur { filter: blur(6px); }
.gs-exp-shadow { filter: drop-shadow(0px 10px 18px rgba(0, 0, 0, 0.55)); }
.gs-exp-glow { filter: drop-shadow(0px 0px 12px rgba(248, 105, 39, 0.75)); }
.gs-exp-gray { filter: grayscale(1); }
.gs-exp-hue { filter: hue-rotate(120deg); }
