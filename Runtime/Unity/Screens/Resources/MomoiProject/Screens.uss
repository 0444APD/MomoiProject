/* MomoiProject 화면 기본 모양. 프로젝트는 DB › 화면 설정의 테마 USS에서 아래 변수와 클래스를 덮어쓴다(이 파일은 고치지 않는다).
   디자인 기본(AI/UiGuide.md 3절): 차가운 검정 + 종이 흰색, 매트·플랫(테두리 강조·그림자 없음). 패널 면은 단색 + 아주 옅은 조각 — 조각은 UI 키트의 KitPanel이 그린다.
   뒷배경은 DB › 화면의 '뒷배경'(일반 · 블러 = 알림만 · UI 배경). 강조색은 하나. */

:root {
    /* 면 색(기본 화면이 쓴다 — 프로젝트 화면의 패널 면은 UI 키트의 KitPanel) */
    --momoi-paper: rgb(244, 243, 240);
    --momoi-paper-text: rgb(38, 38, 42);
    --momoi-paper-dim: rgb(128, 128, 134);
    --momoi-folder: rgb(222, 221, 218);
    --momoi-folder-text: rgb(52, 52, 56);
    --momoi-cover: rgb(36, 37, 41);
    --momoi-cover-text: rgb(236, 236, 238);
    --momoi-stone: rgb(54, 56, 61);
    --momoi-stone-text: rgb(220, 222, 226);
    --momoi-colorpaper: rgb(206, 196, 178);
    --momoi-colorpaper-text: rgb(48, 42, 34);

    /* 화면 공통(기본 화면이 쓴다): 기본 창 = 종이, 버튼 = 검정 표지 */
    --momoi-text: rgb(236, 236, 238);
    --momoi-dim: rgb(150, 152, 158);
    --momoi-panel: rgb(244, 243, 240);
    --momoi-panel-text: rgb(38, 38, 42);
    --momoi-button: rgb(36, 37, 41);
    --momoi-button-text: rgb(236, 236, 238);
    --momoi-button-hover: rgb(58, 60, 66);
    --momoi-accent: rgb(204, 184, 146);
    --momoi-accent-text: rgb(34, 30, 24);
    --momoi-backdrop: rgba(12, 12, 16, 0.22);   /* 블러 뒷배경의 옅은 어둡게 */
    --momoi-ui-backdrop: rgb(222, 220, 214);    /* UI 배경(화면 전체 단색 — 조각은 화면 UXML의 KitPanel) */
    --momoi-ui-text: rgb(60, 60, 66);           /* UI 배경 위 글(나눈 화면의 제목 · 왼쪽 목록) */
    --momoi-line-on-dark: rgba(236, 236, 238, 0.7);   /* 검정 틀 위 테 버튼 */
    --momoi-accent-line: rgba(214, 200, 176, 0.75);   /* 선 포인트(틀 머리 띠) */
    --momoi-radius: 6px;
    --momoi-font-size: 18px;

    /* 게임 상태 색(채도를 낮춘 것 — 막대·표시) */
    --momoi-good: rgb(120, 172, 116);
    --momoi-info: rgb(122, 150, 196);
    --momoi-warn: rgb(204, 160, 92);
    --momoi-danger: rgb(184, 92, 86);
    --momoi-danger-face: rgb(78, 48, 50);
    --momoi-rarity-1: rgb(150, 152, 158);
    --momoi-rarity-2: rgb(110, 160, 130);
    --momoi-rarity-3: rgb(110, 140, 196);
    --momoi-rarity-4: rgb(204, 184, 146);
}

.momoi-root {
    color: var(--momoi-text);
    font-size: var(--momoi-font-size);
}

/* 뒷배경 3가지(DB › 화면 '뒷배경', UiGuide 3-1): 일반 = 장면이 그대로(투명) · 블러 = 알림성만 · UI 배경 = 화면 전체 단색. 입력을 막는 화면이면 아래를 덮는다 */
.momoi-backdrop--plain {
    background-color: rgba(0, 0, 0, 0);
}

.momoi-backdrop--blur {
    background-color: var(--momoi-backdrop);
    backdrop-filter: blur(10px);
}

.momoi-backdrop--ui {
    background-color: var(--momoi-ui-backdrop);
}

.momoi-center {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

/* 기본 창(고르기·설정·슬롯·일시정지·확인) = 종이 */
.momoi-panel {
    background-color: var(--momoi-panel);
    color: var(--momoi-panel-text);
    border-width: 0;
    border-top-left-radius: var(--momoi-radius);
    border-top-right-radius: var(--momoi-radius);
    border-bottom-left-radius: var(--momoi-radius);
    border-bottom-right-radius: var(--momoi-radius);
    padding: 24px 28px;
    min-width: 420px;
    max-width: 1100px;
    max-height: 90%;
}

.momoi-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.momoi-hint,
.momoi-section {
    color: var(--momoi-paper-dim);
    font-size: 15px;
    margin-bottom: 6px;
}

.momoi-section {
    margin-top: 12px;
}

.momoi-message {
    white-space: normal;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.momoi-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* 버튼 = 알약 모양 검정 표지(종이 위에서 또렷하게) */
.momoi-button {
    min-height: 38px;
    min-width: 120px;
    margin: 4px;
    padding: 4px 18px;
    border-width: 0;
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
    background-color: var(--momoi-button);
    color: var(--momoi-button-text);
    font-size: 16px;
}

.momoi-button:hover {
    background-color: var(--momoi-button-hover);
}

.momoi-button:disabled {
    opacity: 0.4;
}

.momoi-button--primary {
    background-color: var(--momoi-accent);
    color: var(--momoi-accent-text);
}

.momoi-button--primary:hover {
    background-color: var(--momoi-accent);
    opacity: 0.9;
}

.momoi-options {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 12px;
}

/* 고르기 창의 후보 = 폴더 색 카드, 고른 것은 검정으로 채움(테두리 없음) */
.momoi-option {
    min-width: 200px;
    min-height: 110px;
    white-space: normal;
    border-width: 0;
    border-top-left-radius: var(--momoi-radius);
    border-top-right-radius: var(--momoi-radius);
    border-bottom-left-radius: var(--momoi-radius);
    border-bottom-right-radius: var(--momoi-radius);
    background-color: var(--momoi-folder);
    color: var(--momoi-folder-text);
}

.momoi-option:hover {
    background-color: rgb(210, 209, 206);
}

.momoi-option__desc {
    font-size: 14px;
    color: var(--momoi-paper-dim);
    white-space: normal;
    margin-top: 6px;
}

.momoi-option--selected {
    background-color: var(--momoi-cover);
    color: var(--momoi-cover-text);
}

.momoi-option--selected .momoi-option__desc {
    color: var(--momoi-dim);
}

/* 틀(검정) 위 버튼: 테 버튼 · 흰 버튼(UiGuide 3-1 — 같은 색 버튼을 두지 않는다) */
.momoi-button--line {
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--momoi-line-on-dark);
    color: var(--momoi-cover-text);
}

.momoi-button--line:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.momoi-button--light {
    background-color: var(--momoi-paper);
    color: var(--momoi-paper-text);
}

.momoi-button--light:hover {
    background-color: rgb(255, 255, 255);
}

/* ── 나눈 화면(ScreenUi.Split — 설정 · 세이브 슬롯, UI 배경 위 · UiGuide 2-3 · 키트 견본 SplitScreen). 1920×1080 기준 자리 ── */
.momoi-split {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--momoi-ui-text);
}

.momoi-split-head {
    position: absolute;
    left: 48px;
    top: 28px;
    flex-direction: row;
    align-items: center;
}

.momoi-split-home {
    width: 56px;
    height: 56px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    background-color: var(--momoi-cover);
}

.momoi-split-title {
    margin-left: 16px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--momoi-ui-text);
}

.momoi-split-close {
    position: absolute;
    right: 48px;
    top: 34px;
    margin: 0;
}

/* 왼쪽 목록: 배경 위 글(판 없음) · 고른 줄만 검정 판(오른쪽만 둥글게) */
.momoi-split-nav {
    position: absolute;
    left: 0;
    top: 150px;
    width: 340px;
}

.momoi-nav-item {
    min-height: 52px;
    margin: 2px 0;
    padding: 8px 16px 8px 72px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.momoi-nav-item:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

.momoi-nav-item--on,
.momoi-nav-item--on:hover {
    background-color: var(--momoi-cover);
}

.momoi-nav-dot {
    width: 6px;
    height: 6px;
    margin-right: 16px;
    flex-shrink: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: var(--momoi-ui-text);
}

.momoi-nav-item--current .momoi-nav-dot,
.momoi-nav-item--on .momoi-nav-dot {
    background-color: var(--momoi-accent);
}

.momoi-nav-texts {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.momoi-nav-text {
    font-size: 18px;
    color: var(--momoi-ui-text);
}

.momoi-nav-sub {
    margin-top: 2px;
    font-size: 13px;
    color: var(--momoi-paper-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.momoi-nav-item--on .momoi-nav-text {
    color: var(--momoi-cover-text);
    -unity-font-style: bold;
}

.momoi-nav-item--on .momoi-nav-sub {
    color: var(--momoi-dim);
}

/* 오른쪽 틀: 검정 틀 → 종이 안판(2중첩) · 머리 띠의 선 포인트 하나 · 아래 버튼 줄 */
.momoi-split-frame {
    position: absolute;
    left: 372px;
    right: 48px;
    top: 128px;
    bottom: 48px;
    padding: 12px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    background-color: var(--momoi-cover);
    color: var(--momoi-cover-text);
}

.momoi-split-frame-head {
    height: 44px;
    padding: 0 12px 0 16px;
    flex-direction: row;
    align-items: center;
}

.momoi-split-mark {
    width: 10px;
    height: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: var(--momoi-accent);
}

.momoi-split-frame-title {
    margin-left: 12px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--momoi-cover-text);
}

.momoi-split-rule {
    flex-grow: 1;
    height: 1px;
    margin: 0 16px;
    background-color: var(--momoi-accent-line);
}

.momoi-split-count {
    font-size: 13px;
    color: var(--momoi-dim);
}

.momoi-split-inner {
    flex-grow: 1;
    padding: 24px 28px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: var(--momoi-paper);
    color: var(--momoi-paper-text);
}

.momoi-split-foot {
    flex-direction: row;
    justify-content: flex-end;
    padding: 12px 4px 0 4px;
}

.momoi-split-scroll {
    flex-grow: 1;
}

/* 설정 항목: 한 줄씩(선 없이 간격으로) · 이름 칸 너비를 맞춘다 */
.momoi-setting {
    min-height: 48px;
    max-width: 1040px;
    margin: 0 0 8px 0;
}

.momoi-settings .unity-base-field__label {
    min-width: 320px;
    font-size: 16px;
    color: var(--momoi-paper-text);
}

.momoi-value {
    min-width: 72px;
    -unity-text-align: middle-right;
}

/* 세이브 슬롯 상세 */
.momoi-slot-summary {
    font-size: 28px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 24px;
}

.momoi-slot-fact {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.momoi-slot-fact-name {
    min-width: 160px;
    font-size: 14px;
    color: var(--momoi-paper-dim);
}

.momoi-slot-fact-value {
    font-size: 20px;
}

.momoi-toasts {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 80px;
    align-items: center;
}

/* 알림 = 검정 표지 알약 */
.momoi-toast {
    background-color: var(--momoi-cover);
    color: var(--momoi-cover-text);
    padding: 8px 22px;
    margin-top: 6px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    font-size: 16px;
}

/* ── 움직임(AI/UiGuide.md 3-5 · ScreenMotion): 씬 전환을 뺀 모든 움직임은 짧게 한 모양으로(개발자 2026-10-13 — 실험실 견본에서 고름).
   화면 전체는 투명도 0↔100% — 나타남 0.189초 ease-out-sine · 사라짐 0.135초 ease-in-sine. 패널(.momoi-motion)은 나타날 때만 짧은 거리를 옆·아래에서 제자리로,
   사라질 때는 미끄러지지 않고 투명도만. 오는 쪽: 기본 아래(위로 떠오름) · --left 왼쪽에서 · --right 오른쪽에서 · --down 위에서.
   USS 곡선에는 quad가 없다(sine이 가장 가깝다). translate로 가운데 맞춘 요소에는 붙이지 않는다. ── */
.momoi-screen-host > * {
    transition-property: opacity;
    transition-duration: 0.189s;
    transition-timing-function: ease-out-sine;
}

.momoi-screen--enter > *,
.momoi-screen--leave > * {
    opacity: 0;
}

.momoi-screen--leave > * {
    transition-duration: 0.135s;
    transition-timing-function: ease-in-sine;
}

.momoi-motion {
    transition-property: opacity, translate;
    transition-duration: 0.189s;
    transition-timing-function: ease-out-sine;
}

/* 사라짐: 투명도만 */
.momoi-screen--leave .momoi-motion,
.momoi-motion.momoi-motion--hidden {
    opacity: 0;
    transition-duration: 0.135s;
    transition-timing-function: ease-in-sine;
}

/* 나타나기 전(시간 0): 오는 쪽에 둔다 — 화면이 처음 그려질 때(--enter)와 ScreenMotion.Show(--pre) */
.momoi-screen--enter .momoi-motion,
.momoi-motion.momoi-motion--pre {
    opacity: 0;
    translate: 0 14px;
    transition-duration: 0s;
}

.momoi-screen--enter .momoi-motion--left,
.momoi-motion--left.momoi-motion--pre {
    translate: -18px 0;
}

.momoi-screen--enter .momoi-motion--right,
.momoi-motion--right.momoi-motion--pre {
    translate: 18px 0;
}

.momoi-screen--enter .momoi-motion--down,
.momoi-motion--down.momoi-motion--pre {
    translate: 0 -14px;
}
