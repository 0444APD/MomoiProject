<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 배치 G — 이벤트(조우·선택지): 모든 이벤트에 선택지가 있다(전투 이벤트도 선택지 뒤에 전투).
         필드 이벤트 = 걷던 캐릭터는 멈춰 서고(월드 쪽 아이들), 장면 위 글 띠(band) + 오른쪽 선택지 줄 — 캐릭터·핸드를 가리지 않는다.
         풀일러 이벤트 = 이벤트 그림이 화면을 채우고(월드 쪽 — 장면·캐릭터 위, 다이얼로그 배경 아래), 오른쪽에 종이 설명(art-text) + 선택지.
         대사(다이얼로그)가 있으면 대사가 끝난 뒤 선택지. 선택지 버튼은 화면 코드가 이벤트 데이터에서 만든다(kit-choice — 번호 · 글, 전투는 kit-choice +battle).
         화면 코드는 ScreenMotion.Show로 band·art-text·choices를 보이고 숨긴다(오른쪽에서 짧게 들어온다). 층 = 바탕. -->
    <ui:VisualElement class="kit-screen" picking-mode="Ignore">
        <ui:VisualElement name="band" class="kit-event-band momoi-motion momoi-motion--down" picking-mode="Ignore">
            <ui:Label name="band-title" class="kit-event-title" />
            <ui:Label name="band-text" class="kit-event-text" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-event-side" picking-mode="Ignore">
            <ui:VisualElement name="art-text" class="kit-fullart-text momoi-mat-paper momoi-motion momoi-motion--right" picking-mode="Ignore">
                <ui:Label name="art-title" class="kit-fullart-title" />
                <ui:Label name="art-desc" class="kit-popup-desc" />
            </ui:VisualElement>
            <ui:VisualElement name="choices" class="kit-choices momoi-motion momoi-motion--right">
                <!-- 화면 코드가 만드는 선택지 하나의 모양:
                <ui:Button name="choice-0" class="kit-choice momoi-mat-cover">
                    <ui:Label text="1" class="kit-choice-index" picking-mode="Ignore" />
                    <ui:Label text="선택지 글" class="kit-choice-text" picking-mode="Ignore" />
                </ui:Button>
                -->
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
