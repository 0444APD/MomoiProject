<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="CardA_Tile" src="../Items/CardA_Tile.uxml" />
    <!-- 배치 E — 양옆 패널형(창고·가방·컨테이너·거점 메뉴): 가운데 장면을 그대로 두고 양옆에 판(왼쪽 = 상대·보관함, 오른쪽 = 내 것).
         플레이 중 핸드와 함께 쓰면 kit-sidepanel +low(아래 띠를 비움) + 화면 항목 '아래 입력 막기' 끔. 판 위 분류는 탭 C(폴더 탭). 층 = 창. -->
    <ui:VisualElement class="kit-screen" picking-mode="Ignore">
        <ui:VisualElement class="kit-sidepanel kit-sidepanel--left momoi-mat-cover">
            <ui:Label name="left-title" class="kit-tag momoi-mat-stone" />
            <ui:ScrollView class="kit-scroll kit-gap">
                <ui:VisualElement name="left" class="kit-grid" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="kit-sidepanel kit-sidepanel--right momoi-mat-cover">
            <ui:VisualElement class="kit-hrow">
                <ui:Label name="right-title" class="kit-tag momoi-mat-stone" />
                <ui:VisualElement class="kit-topbar-space" />
                <ui:Button name="close" text="✕" class="kit-close" />
            </ui:VisualElement>
            <ui:ScrollView class="kit-scroll kit-gap">
                <ui:VisualElement name="right" class="kit-grid" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
