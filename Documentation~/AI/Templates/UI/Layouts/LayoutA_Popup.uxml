<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="CardA_Tile" src="../Items/CardA_Tile.uxml" />
    <!-- 배치 A — 팝업형: 흐린 장면 위 가운데 팝업 하나(도움말·보상 미리보기·교환·결과·확인). 층 = 팝업(뒤 흐림은 GBible 바탕이 준다).
         여기 예시 = 틀 A(종이) + 머리 B(제목) + 목록 A(격자). 머리는 Panels/PopupHeads의 A~D, 틀은 Panels/PopupFrames의 A~D로 바꿔 끼운다.
         바깥: 양옆 넘기기(쪽이 여럿일 때) · 아래 닫는 법 안내. -->
    <ui:VisualElement class="kit-screen kit-center" picking-mode="Ignore">
        <ui:VisualElement class="kit-hrow">
            <ui:Button name="prev" text="‹" class="kit-page-arrow" />
            <ui:VisualElement class="kit-popup kit-popup--l momoi-mat-paper">
                <ui:VisualElement class="kit-popup-head">
                    <ui:Label name="title" class="kit-popup-title" />
                    <ui:Button name="close" text="✕" class="kit-close" />
                </ui:VisualElement>
                <ui:VisualElement class="kit-rule" />
                <ui:VisualElement class="kit-popup-body">
                    <ui:Label name="desc" class="kit-popup-desc" />
                    <ui:ScrollView class="kit-scroll">
                        <ui:VisualElement name="grid" class="kit-grid" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="kit-popup-foot">
                    <ui:Label name="page" class="kit-page" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="next" text="›" class="kit-page-arrow" />
        </ui:VisualElement>
        <ui:Label name="dismiss" class="kit-dismiss" />
    </ui:VisualElement>
</ui:UXML>
