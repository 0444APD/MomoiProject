<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 배치 F — 거점(로비): 배경 일러가 화면을 채우고, 가운데 캐릭터 + 아래 대사 상자 + 위 장소 알약 + 오른쪽 작은 세로 메뉴.
         두 패널이 주고받는 메뉴(창고·가방 — 배치 F의 두 패널)를 열면 화면 코드가 hub에 kit-hub +aside를 붙인다:
         캐릭터가 왼쪽으로 스르륵 비키고(0.32초) 대사·메뉴는 사라지며, 가운데(kit-pair +center)와 오른쪽(kit-pair +right)에 패널이 선다.
         배경·캐릭터 그림은 프로젝트 USS가 background-image로(반영 스크립트의 AssetRequests 임시 그림 경로). 층 = 바탕. -->
    <!-- 두 패널은 따로 여는 창이다 — LayoutF_HubPair.uxml -->
    <ui:VisualElement name="hub" class="kit-screen">
        <ui:VisualElement class="kit-hub-bg xx-hub-bg" picking-mode="Ignore" />
        <ui:VisualElement name="guest" class="kit-hub-guest xx-guest-art" picking-mode="Ignore" />
        <ui:Label binding-path="@kit.place" class="kit-hub-place momoi-mat-stone" />
        <ui:VisualElement class="kit-hub-talk" picking-mode="Ignore">
            <ui:Label name="guest-name" class="kit-hub-talk-name momoi-mat-cover" />
            <ui:Label binding-path="@kit.line" class="kit-hub-talk-line momoi-mat-paper" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-hub-menu">
            <ui:Button name="menu-a" binding-path="@kit.menuA" class="kit-btn" />
            <ui:Button name="menu-go" binding-path="@kit.go" class="kit-btn kit-btn--primary" />
            <ui:Button name="settings" binding-path="@menu.settings" class="kit-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
