<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="CardA_Tile" src="../Items/CardA_Tile.uxml" />
    <!-- 배치 F의 두 패널(창고·가방처럼 서로 주고받는 메뉴): 거점(LayoutF_Hub)의 캐릭터가 왼쪽으로 비킨 자리 옆 가운데·오른쪽에 나란히.
         층 = 창. 플레이 중(핸드와 함께)이면 두 패널에 kit-pair +low(아래 띠를 비움)와 화면 항목 '아래 입력 막기' 끔.
         대상을 골라야 하는 행동(아이템 쓰기 → 캐릭터·보드)을 시작하면 이 창을 닫는다(대상이 가려지지 않게 — UiGuide 2-3).
         가운데 판이 쓸 곳이 없으면(전투 중 컨테이너 없음) ScreenMotion.Show로 숨기고 오른쪽 판만. -->
    <ui:VisualElement class="kit-screen" picking-mode="Ignore">
        <ui:VisualElement name="left-panel" class="kit-pair kit-pair--center momoi-mat-cover momoi-motion momoi-motion--right">
            <ui:Label name="left-title" class="kit-panel-title" />
            <ui:ScrollView class="kit-scroll">
                <ui:VisualElement name="left" class="kit-grid" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="right-panel" class="kit-pair kit-pair--right momoi-mat-cover momoi-motion momoi-motion--right">
            <ui:VisualElement class="kit-hrow">
                <ui:Label name="right-title" class="kit-panel-title" />
                <ui:VisualElement class="kit-topbar-space" />
                <ui:Button name="close" class="kit-close">
                    <MomoiProject.KitIcon glyph="Close" class="kit-icon" />
                </ui:Button>
            </ui:VisualElement>
            <ui:ScrollView class="kit-scroll">
                <ui:VisualElement name="right" class="kit-grid" />
            </ui:ScrollView>
            <ui:VisualElement class="kit-actions">
                <ui:Label name="picked" class="kit-chip-label" />
                <ui:VisualElement class="kit-topbar-space" />
                <ui:Button name="act-use" binding-path="@kit.use" class="kit-btn kit-btn--small kit-btn--light" />
                <ui:Button name="act-move" binding-path="@kit.move" class="kit-btn kit-btn--small kit-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
