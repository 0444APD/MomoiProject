<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="CardB_Portrait" src="../Items/CardB_Portrait.uxml" />
    <ui:Template name="CardA_Tile" src="../Items/CardA_Tile.uxml" />
    <!-- 배치 B — 목록·상세형(어두운 전체 화면)(인벤토리 · 캐릭터 명단 · 도감 · 소지품): 검정 표지 바탕(희미한 조각 결).
         위 = 홈 배지·제목 · 재화 알약·뒤로 · 왼쪽 = 원형 옆 탭 · 가운데 = 꼬리표 + 격자(세로 카드나 타일) · 오른쪽 = 종이 상세 · 왼쪽 아래 = 거르기.
         층: 창(전체 — 뒤를 가리므로 흐림이 보이지 않는다). -->
    <ui:VisualElement class="kit-screen momoi-mat-cover">
        <ui:VisualElement class="kit-topbar">
            <ui:Button name="home" class="kit-home momoi-mat-paper" />
            <ui:Label name="title" class="kit-topbar-title" />
            <ui:VisualElement class="kit-topbar-space" />
            <ui:VisualElement name="currencies" class="kit-hrow" />
            <ui:Button name="back" text="↩" class="kit-icon-btn kit-icon-btn--light" />
        </ui:VisualElement>
        <ui:VisualElement name="tabs" class="kit-side-tabs" />
        <ui:VisualElement class="kit-collection-main">
            <ui:Label name="section" class="kit-tag momoi-mat-stone" />
            <ui:ScrollView class="kit-scroll kit-gap">
                <ui:VisualElement name="grid" class="kit-grid" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="kit-detail kit-collection-detail momoi-mat-paper">
            <ui:Label name="detail-title" class="kit-detail-title" />
            <ui:VisualElement name="detail-banner" class="kit-detail-banner momoi-mat-cover" />
            <ui:VisualElement class="kit-hrow">
                <ui:Label name="detail-grade" class="kit-pill-tag momoi-mat-cover" />
                <ui:Label name="detail-stars" class="kit-stars" />
            </ui:VisualElement>
            <ui:Label name="detail-desc" class="kit-detail-desc" />
            <ui:VisualElement class="kit-detail-foot">
                <ui:Button name="detail-action" class="kit-btn kit-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="filter" class="kit-btn kit-btn--small kit-btn--light kit-collection-filter" />
    </ui:VisualElement>
</ui:UXML>
