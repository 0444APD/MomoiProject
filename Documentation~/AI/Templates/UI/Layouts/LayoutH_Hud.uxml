<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="HandCard" src="../Items/HandCard.uxml" />
    <!-- 배치 H — 플레이 HUD(UiGuide 2-2의 자리): 장면(월드) 위.
         왼쪽 위 = 상태 알약(남은 시간 · 지금 상태 — 고르는 중이면 '무엇을 누구에게') · 가운데 위 = 진행(출발 ─ 막대 ─ 도착) ·
         오른쪽 위 = 작은 원형 시스템 버튼(지도·가방·일시정지) · 오른쪽 아래 = 그때만 쓰는 버튼 세로 줄(취소·도주·멈추기) ·
         아래 = 핸드 펼치기(양옆 덱·버린 더미) + 가운데 아래 주 자원. 월드 오브젝트에 붙는 칸(이름·체력)은 world-tags에 화면 코드가 Tick에서 놓는다.
         핸드 부채꼴(기울기·높이)은 화면 코드가 칸 뿌리(TemplateContainer)에, 카드의 들림·커짐은 USS. 층 = 바탕. -->
    <ui:VisualElement class="kit-screen" picking-mode="Ignore">
        <ui:VisualElement name="world-tags" class="kit-screen" picking-mode="Ignore" />
        <ui:VisualElement class="kit-hud-left" picking-mode="Ignore">
            <ui:VisualElement class="kit-chip momoi-mat-stone" picking-mode="Ignore">
                <MomoiProject.KitIcon glyph="Refresh" class="kit-icon" />
                <ui:Label name="time" class="kit-chip-value" />
            </ui:VisualElement>
            <ui:VisualElement class="kit-chip momoi-mat-stone" picking-mode="Ignore">
                <MomoiProject.KitIcon glyph="Info" class="kit-icon" />
                <ui:Label name="status" class="kit-chip-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="kit-hud-center" picking-mode="Ignore">
            <ui:Label name="from" class="kit-node-pill momoi-mat-stone" />
            <ui:VisualElement class="kit-progress">
                <ui:VisualElement name="progress-fill" class="kit-progress-fill" />
            </ui:VisualElement>
            <ui:Label name="to" class="kit-node-pill momoi-mat-stone" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-hud-right">
            <ui:Button name="map" class="kit-icon-btn"><MomoiProject.KitIcon glyph="Map" class="kit-icon" /></ui:Button>
            <ui:Button name="bag" class="kit-icon-btn"><MomoiProject.KitIcon glyph="Bag" class="kit-icon" /></ui:Button>
            <ui:Button name="pause" class="kit-icon-btn"><MomoiProject.KitIcon glyph="Pause" class="kit-icon" /></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="kit-hud-actions">
            <ui:Button name="cancel" binding-path="@kit.cancel" class="kit-btn kit-btn--small" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-hand" picking-mode="Ignore">
            <ui:Button name="deck" class="kit-pile momoi-mat-stone">
                <MomoiProject.KitIcon glyph="Card" class="kit-icon" />
                <ui:Label name="deck-count" class="kit-pile-count" />
            </ui:Button>
            <ui:VisualElement name="hand" class="kit-hand-row" picking-mode="Ignore" />
            <ui:Button name="discard" class="kit-pile momoi-mat-stone">
                <MomoiProject.KitIcon glyph="Refresh" class="kit-icon" />
                <ui:Label name="discard-count" class="kit-pile-count" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="kit-resource momoi-mat-cover" picking-mode="Ignore">
            <MomoiProject.KitIcon glyph="Gem" class="kit-icon" />
            <ui:Label name="resource" class="kit-resource-value" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
