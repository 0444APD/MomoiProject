<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 상세 A~D — 목록에서 고른 것(캐릭터·아이템·카드)을 보이는 판. 고를 수 있게 늘어놓은 조각이다. -->

    <!-- A 종이 세로 판(오른쪽): 제목 · 배너 · 등급·별 · 설명 · 아래 가운데 알약 버튼 (배치 B의 기본) -->
    <ui:VisualElement class="kit-detail kit-collection-detail momoi-mat-paper">
        <ui:Label name="detail-title" class="kit-detail-title" />
        <ui:VisualElement name="detail-banner" class="kit-detail-banner momoi-mat-cover" />
        <ui:VisualElement class="kit-hrow">
            <ui:Label name="detail-grade" class="kit-pill-tag momoi-mat-cover" />
            <ui:Label name="detail-stars" class="kit-stars" />
        </ui:VisualElement>
        <ui:Label name="detail-desc" class="kit-detail-desc" />
        <ui:VisualElement class="kit-detail-foot">
            <ui:Button name="detail-action" class="kit-btn kit-btn--primary" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- B 검정 세로 판(오른쪽): A와 같은 칸, 밝은 화면(배치 C·E) 위에서 -->
    <ui:VisualElement class="kit-detail kit-collection-detail momoi-mat-cover">
        <ui:Label name="detail-title" class="kit-detail-title" />
        <ui:VisualElement name="detail-banner" class="kit-detail-banner momoi-mat-stone" />
        <ui:Label name="detail-desc" class="kit-detail-desc" />
        <ui:VisualElement class="kit-detail-foot">
            <ui:Button name="detail-action" class="kit-btn kit-btn--light" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- C 아래 가로 정보 띠: 그림 · 이름·설명 · 버튼을 한 줄로(격자를 넓게 쓸 때) -->
    <ui:VisualElement class="kit-infobar momoi-mat-paper">
        <ui:VisualElement name="detail-thumb" class="kit-infobar-thumb momoi-mat-cover" />
        <ui:VisualElement class="kit-infobar-text">
            <ui:Label name="detail-title" class="kit-detail-title" />
            <ui:Label name="detail-desc" class="kit-detail-desc" />
        </ui:VisualElement>
        <ui:Button name="detail-action" class="kit-btn kit-btn--primary" />
    </ui:VisualElement>

    <!-- D 큰 일러 + 겹친 종이 카드: 왼쪽 큰 일러, 오른쪽에 세로 카드와 설명·버튼 (캐릭터 고르기 — 배치 D) -->
    <ui:VisualElement>
        <ui:VisualElement name="showcase-art" class="kit-showcase-art" picking-mode="Ignore" />
        <ui:VisualElement class="kit-showcase-card">
            <ui:VisualElement name="showcase-portrait" class="kit-showcase-portrait momoi-mat-cover" />
            <ui:VisualElement class="kit-showcase-text momoi-mat-paper">
                <ui:Label name="detail-title" class="kit-detail-title" />
                <ui:Label name="detail-desc" class="kit-detail-desc" />
                <ui:VisualElement class="kit-hrow kit-gap">
                    <MomoiProject.KitShape shape="Slant" slant="14" name="detail-action" class="kit-slant-btn kit-slant-btn--primary">
                        <ui:Label name="detail-action-label" class="kit-slant-btn-label" />
                    </MomoiProject.KitShape>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
