<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 팝업 머리 A~D — 팝업 틀(PopupFrames) 맨 위에 하나를 넣는다. 아래 넷은 고를 수 있게 늘어놓은 조각이다(화면에 넷 다 쓰지 않는다). -->

    <!-- A 띠 머리: 폴더 색 띠에 제목 · ✕ (도움말·설명 페이지) -->
    <ui:VisualElement class="kit-popup-band momoi-mat-folder">
        <ui:Label name="title" class="kit-popup-title" />
        <ui:Button name="close" text="✕" class="kit-close" />
    </ui:VisualElement>

    <!-- B 제목 머리: 왼쪽 위 굵은 제목 · ✕ · 아래 옅은 줄 (보상 미리보기·속성 정보·목록) -->
    <ui:VisualElement>
        <ui:VisualElement class="kit-popup-head">
            <ui:Label name="title" class="kit-popup-title" />
            <ui:Button name="close" text="✕" class="kit-close" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-rule" />
    </ui:VisualElement>

    <!-- C 가운데 제목 머리: 왼쪽 재화 알약 · 가운데 제목 · 오른쪽 ✕ · 옅은 줄 (교환·상점·보상 고르기) -->
    <ui:VisualElement>
        <ui:VisualElement class="kit-popup-head kit-popup-head--center">
            <ui:VisualElement class="kit-currency momoi-mat-cover">
                <ui:VisualElement name="currency-icon" class="kit-currency-icon" />
                <ui:Label name="currency" class="kit-currency-value" />
            </ui:VisualElement>
            <ui:Label name="title" class="kit-popup-title" />
            <ui:Button name="close" text="✕" class="kit-close" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-rule" />
    </ui:VisualElement>

    <!-- D 꼬리표 머리: 종이 위 왼쪽에 걸친 검정 꼬리표(비스듬한 끝)에 제목 · 오른쪽 ✕ (결과·알림·중요한 창). KitShape 필요 -->
    <ui:VisualElement class="kit-popup-headtag-row">
        <MomoiProject.KitShape shape="SlantEnd" slant="16" class="kit-popup-headtag">
            <ui:Label name="title" class="kit-popup-headtag-title" />
        </MomoiProject.KitShape>
        <ui:Button name="close" text="✕" class="kit-close" />
    </ui:VisualElement>
</ui:UXML>
