<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 버튼 A~D — 모두 테두리 없이 면으로. 크기 변형 kit-btn--small. 고를 수 있게 늘어놓은 조각이다. -->

    <!-- A 검정 알약: 종이·밝은 화면 위 기본 버튼 -->
    <ui:Button name="action" class="kit-btn" />
    <!-- A' 강조 알약: 화면에서 가장 중요한 행동 하나(성장·출발·받기) -->
    <ui:Button name="primary" class="kit-btn kit-btn--primary" />

    <!-- B 종이 알약: 검정 화면 위 기본 버튼 · 폴더 색 알약(밝은 화면의 보조 — 순서 변경 등) -->
    <ui:Button name="action-light" class="kit-btn kit-btn--light" />
    <ui:Button name="action-folder" class="kit-btn kit-btn--folder" />

    <!-- C 원형 아이콘: 뒤로·도움말·새로 고침·설정(글자 대신 기호·아이콘) -->
    <ui:Button name="back" text="↩" class="kit-icon-btn" />
    <ui:Button name="help" text="?" class="kit-icon-btn kit-icon-btn--tiny" />

    <!-- D 비스듬한 칸: 강한 주된 행동(전투 시작·확정). KitShape 필요 -->
    <MomoiProject.KitShape name="go" shape="Slant" slant="14" class="kit-slant-btn kit-slant-btn--primary">
        <ui:Label name="go-label" class="kit-slant-btn-label" />
    </MomoiProject.KitShape>
</ui:UXML>
