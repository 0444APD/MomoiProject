<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 목록 A~D — 카드 칸(Items/CardA~D · Row · Banner)을 담는 그릇. 화면 코드가 List<T>(그릇 이름, Item("칸"), …)로 채운다.
         고를 수 있게 늘어놓은 조각이다. -->

    <!-- A 격자: 줄을 넘겨 감싸며 늘어선다(인벤토리·전리품·도감) -->
    <ui:ScrollView class="kit-scroll">
        <ui:VisualElement name="grid" class="kit-grid" />
    </ui:ScrollView>

    <!-- B 표: 표 줄(Items/Row)이 위에서 아래로(속성·능력치 비교·순위) -->
    <ui:ScrollView class="kit-scroll">
        <ui:VisualElement name="rows" />
    </ui:ScrollView>

    <!-- C 가로 줄: 화면 아래 한 줄로(캐릭터 명단·핸드·고를 후보). 넘치면 가로로 넘긴다 -->
    <ui:ScrollView mode="Horizontal" class="kit-strip-area">
        <ui:VisualElement name="strip" class="kit-strip" />
    </ui:ScrollView>

    <!-- D 묶음: 꼬리표마다 격자 하나(분류별 도감·인벤토리). 묶음(section)을 코드가 되풀이해 만든다 -->
    <ui:ScrollView class="kit-scroll">
        <ui:VisualElement name="sections">
            <ui:VisualElement class="kit-section">
                <ui:Label name="section-title" class="kit-tag momoi-mat-cover" />
                <ui:VisualElement name="section-grid" class="kit-grid" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
