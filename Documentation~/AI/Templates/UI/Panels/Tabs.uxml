<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 탭 A~D — 같은 화면 안의 분류를 바꾼다. 고른 탭은 면(채움·종이·밑 띠)으로 보인다. 고를 수 있게 늘어놓은 조각이다. -->

    <!-- A 옆 원형 탭: 왼쪽 세로 줄(어두운 전체 화면 — 배치 B) -->
    <ui:VisualElement name="tabs" class="kit-side-tabs">
        <ui:Button text="●" class="kit-side-tab kit-side-tab--on" />
        <ui:Button text="●" class="kit-side-tab" />
    </ui:VisualElement>

    <!-- B 아래 탭 막대: 검정 막대 위 비스듬한 칸(프리셋·쪽 — 배치 C). 칸은 Items/Tab. KitShape 필요 -->
    <ui:VisualElement name="tabbar" class="kit-tabbar momoi-mat-cover" />

    <!-- C 위 폴더 탭: 서류철처럼 판 위에 붙은 탭 — 고른 탭은 아래 종이 판과 이어진다(팝업·양옆 패널 안의 분류) -->
    <ui:VisualElement>
        <ui:VisualElement name="folder-tabs" class="kit-folder-tabs">
            <ui:Button class="kit-ftab kit-ftab--on" />
            <ui:Button class="kit-ftab" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-popup kit-popup--m momoi-mat-paper" />
    </ui:VisualElement>

    <!-- D 글자 탭: 글자만, 고른 탭에 강조색 밑 띠(위 막대 가운데 · 상세 판 안) -->
    <ui:VisualElement name="text-tabs" class="kit-text-tabs">
        <ui:Button class="kit-ttab kit-ttab--on" />
        <ui:Button class="kit-ttab" />
    </ui:VisualElement>
</ui:UXML>
