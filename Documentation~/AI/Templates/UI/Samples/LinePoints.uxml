<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 견본 · 선 포인트 7가지(KitAccent). 한 화면에 포인트 패널은 하나(A 패널, 한 종류) — 나머지 패널은 선 없이. 선은 한 면 끝에서 끝까지, 1px · 0.5px -->
    <ui:VisualElement class="kit-fill" picking-mode="Ignore">
        <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="110" pieces="20" class="kit-fill kit-pn-paper kit-pn-faint" picking-mode="Ignore" />
        <ui:VisualElement class="kit-center" picking-mode="Ignore">
            <ui:VisualElement class="kit-sample-grid" picking-mode="Ignore">
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="111" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="CornerMarks" class="kit-accent kit-ac-on-dark" /><ui:Label text="네 모서리 ㄱ" class="kit-sample-name" /><ui:Label text="짧은 ㄱ — 점 · 별빛 같은 표시" class="kit-sample-note" /></MomoiProject.KitPanel>
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="112" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="CornerMarksTwo" class="kit-accent kit-ac-on-dark" /><ui:Label text="두 모서리 ㄱ" class="kit-sample-name" /><ui:Label text="왼쪽 위 · 오른쪽 아래 표시" class="kit-sample-note" /></MomoiProject.KitPanel>
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="113" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="TwoSides" class="kit-accent kit-ac-on-dark" /><ui:Label text="두 면" class="kit-sample-name" /><ui:Label text="위 · 왼쪽 끝에서 끝까지 · 모서리에 점" class="kit-sample-note" /></MomoiProject.KitPanel>
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="114" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="OppositeL" class="kit-accent kit-ac-on-dark" /><ui:Label text="마주 보는 ㄱ" class="kit-sample-name" /><ui:Label text="굵은 ㄱ + 얇은 ㄱ, 두 모서리 비움" class="kit-sample-note" /></MomoiProject.KitPanel>
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="115" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="BrokenFrame" class="kit-accent kit-ac-on-dark" /><ui:Label text="끊긴 테두리" class="kit-sample-name" /><ui:Label text="얇은 선 · 위아래 별빛 하나씩" class="kit-sample-note" /></MomoiProject.KitPanel>
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="116" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="ArcFrame" class="kit-accent kit-ac-on-dark" /><ui:Label text="원호 모서리" class="kit-sample-name" /><ui:Label text="얇은 선 · 안쪽 원호 · X 별빛 하나" class="kit-sample-note" /></MomoiProject.KitPanel>
                <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="117" class="kit-sample-box kit-sample-box--accent kit-pn-dark"><MomoiProject.KitAccent kind="BackBox" side="Right" inset="6" class="kit-accent kit-ac-on-paper" /><ui:Label text="뒤 상자" class="kit-sample-name" /><ui:Label text="패널 뒤로 6px 밀린 선 상자 · 모서리 십자" class="kit-sample-note" /></MomoiProject.KitPanel>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
