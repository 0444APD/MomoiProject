<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 견본 · 변칙 돌려쓰기: 변칙(자름 · 잎)은 둘 다 쓰되 한 화면에 한 가지 — 그 화면의 제목 막대 · 가로 메뉴 막대(안쪽 판까지) · 버튼이 같은 모양. 왼쪽 자름, 오른쪽 잎.
         가운데 칸은 여럿 늘어서는 요소라 베젤 없이 단순하게(라인 디자인 없음) -->
    <ui:VisualElement class="kit-fill" picking-mode="Ignore">
        <MomoiProject.KitPanel shape="Square" pattern="Shards" seed="321" pieces="20" class="kit-fill kit-pn-gray kit-pn-faint" picking-mode="Ignore" />
        <ui:VisualElement class="sample-head"><ui:Label text="변칙 돌려쓰기" class="sample-title" /><ui:Label text="한 화면에는 변칙 한 가지 — 제목 막대 · 가로 메뉴 막대(안쪽 판까지) · 버튼이 같은 모양" class="sample-sub" /></ui:VisualElement>
        <MomoiProject.KitPanel shape="Round" pattern="Shards" seed="331" class="sample-side sample-side--left kit-on-paper kit-pn-paper kit-pn-c12">
            <ui:Label text="변칙 · 자름 — 한 화면에 한 가지" class="sample-caption" />
            <MomoiProject.KitPanel shape="Chamfer" corners="tr bl" pattern="None" class="kit-titlebar"><ui:Label text="유물 도감" class="kit-titlebar-text" /><ui:Label text="03 / 12" class="kit-titlebar-count" /></MomoiProject.KitPanel>
            <ui:VisualElement class="sample-gap" />
            <MomoiProject.KitPanel shape="Chamfer" corners="tr bl" pattern="None" class="kit-menu"><ui:Label text="전체" class="kit-menu-item" /><MomoiProject.KitPanel shape="Chamfer" corners="tr bl" pattern="None" class="kit-menu-on"><ui:Label text="패시브 효과" class="kit-menu-item" /></MomoiProject.KitPanel><ui:Label text="액티브 효과" class="kit-menu-item" /><ui:Label text="세트" class="kit-menu-item" /><ui:Label text="잠김" class="kit-menu-item" /></MomoiProject.KitPanel>
            <ui:VisualElement class="sample-slots"><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="sample-foot"><ui:Button class="kit-bt kit-bt--cut kit-bt--text"><MomoiProject.KitPanel shape="Chamfer" corners="tr bl" pattern="None" class="kit-bt-face" picking-mode="Ignore" /><ui:Label text="정렬" class="kit-bt-text" picking-mode="Ignore" /></ui:Button><ui:Button class="kit-bt kit-bt--cut kit-bt--line"><MomoiProject.KitPanel shape="Chamfer" corners="tr bl" pattern="None" line="Double" class="kit-bt-face" picking-mode="Ignore" /><ui:Label text="닫기" class="kit-bt-text" picking-mode="Ignore" /></ui:Button><ui:Button class="kit-bt kit-bt--cut kit-bt--black"><MomoiProject.KitPanel shape="Chamfer" corners="tr bl" pattern="None" class="kit-bt-face" picking-mode="Ignore" /><ui:Label text="장착" class="kit-bt-text" picking-mode="Ignore" /></ui:Button></ui:VisualElement>
        </MomoiProject.KitPanel>
        <MomoiProject.KitPanel shape="Round" pattern="Shards" seed="332" class="sample-side sample-side--right kit-on-paper kit-pn-paper kit-pn-c12">
            <ui:Label text="변칙 · 잎 — 한 화면에 한 가지" class="sample-caption" />
            <MomoiProject.KitPanel shape="Square" corners="tl br" pattern="None" class="kit-titlebar"><ui:Label text="유물 도감" class="kit-titlebar-text" /><ui:Label text="03 / 12" class="kit-titlebar-count" /></MomoiProject.KitPanel>
            <ui:VisualElement class="sample-gap" />
            <MomoiProject.KitPanel shape="Square" corners="tl br" pattern="None" class="kit-menu"><ui:Label text="전체" class="kit-menu-item" /><MomoiProject.KitPanel shape="Square" corners="tl br" pattern="None" class="kit-menu-on"><ui:Label text="패시브 효과" class="kit-menu-item" /></MomoiProject.KitPanel><ui:Label text="액티브 효과" class="kit-menu-item" /><ui:Label text="세트" class="kit-menu-item" /><ui:Label text="잠김" class="kit-menu-item" /></MomoiProject.KitPanel>
            <ui:VisualElement class="sample-slots"><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement><ui:VisualElement class="kit-slot"><MomoiProject.KitSpark class="kit-slot-mark" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="sample-foot"><ui:Button class="kit-bt kit-bt--leaf kit-bt--text"><MomoiProject.KitPanel shape="Square" corners="tl br" pattern="None" class="kit-bt-face" picking-mode="Ignore" /><ui:Label text="정렬" class="kit-bt-text" picking-mode="Ignore" /></ui:Button><ui:Button class="kit-bt kit-bt--leaf kit-bt--line"><MomoiProject.KitPanel shape="Square" corners="tl br" pattern="None" line="Double" class="kit-bt-face" picking-mode="Ignore" /><ui:Label text="닫기" class="kit-bt-text" picking-mode="Ignore" /></ui:Button><ui:Button class="kit-bt kit-bt--leaf kit-bt--black"><MomoiProject.KitPanel shape="Square" corners="tl br" pattern="None" class="kit-bt-face" picking-mode="Ignore" /><ui:Label text="장착" class="kit-bt-text" picking-mode="Ignore" /></ui:Button></ui:VisualElement>
        </MomoiProject.KitPanel>
    </ui:VisualElement>
</ui:UXML>
