<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 견본 · 게이지(KitGauge)와 장면 위 UI(UiGuide 3-1 · 3-7, 개발자 2026-10-15).
         왼쪽 위 = 장면 위 상태 UI의 쓰는 법(묶는 패널 없이 여백으로 · 초상 · 아이콘 칸만 패널 · 글만 놓이는 것은 강조 숫자).
         가운데 = 게이지의 경우의 수 전부: 직선(사각 · 평행사변형 × 꽉 채움 · 뒤 판 두껍게) · 눈금 · 특수(그라데이션 + 빛 번짐) · 원형 패널 · 원 테두리 · 도형 나열.
         둥근 모양은 쓰지 않는다(모서리만 아주 약간). 색은 게이지마다 color 속성(뒷 게이지 색은 여기서 저절로 — 줄 때 더 밝게 · 찰 때 더 어둡게).
         오른쪽 버튼 = 움직임을 단계마다 따로(찰 몫만 띄우기 → 채우기 · 깎기만 → 따라 줄기) 또는 지름길(Set). 코드 GaugesSample.cs.txt -->
    <ui:VisualElement class="kit-fill sample-gauges-scene" picking-mode="Ignore">
        <ui:VisualElement class="sample-gauges-me">
            <MomoiProject.KitPanel shape="Round" pattern="None" class="sample-gauges-portrait kit-pn-dark kit-pn-c6"><ui:VisualElement class="sample-gauges-portrait-art" /></MomoiProject.KitPanel>
            <ui:VisualElement class="sample-gauges-me-info">
                <ui:Label text="리라" class="sample-gauges-name" />
                <MomoiProject.KitGauge name="hp" kind="Line" shape="Slant" frame="Inset" value="0.72" text="86 / 120" color="#C86058" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-hp" />
                <MomoiProject.KitGauge name="mp" kind="Line" shape="Rect" frame="Flush" value="0.6" segments="10" color="#6C94D4" class="kit-gauge sample-gauges-demo sample-gauges-mp" />
                <ui:VisualElement class="sample-gauges-buffs">
                    <ui:VisualElement class="sample-gauges-buff">
                        <MomoiProject.KitPanel shape="Round" pattern="None" class="sample-gauges-buff-icon kit-pn-dark kit-pn-c6"><MomoiProject.KitIcon glyph="Sword" class="sample-gauges-buff-glyph" /></MomoiProject.KitPanel>
                        <MomoiProject.KitGauge name="buff-1" value="0.8" color="#96C48C" class="kit-gauge kit-gauge--thin sample-gauges-buff-bar" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sample-gauges-buff">
                        <MomoiProject.KitPanel shape="Round" pattern="None" class="sample-gauges-buff-icon kit-pn-dark kit-pn-c6"><MomoiProject.KitIcon glyph="Shield" class="sample-gauges-buff-glyph" /></MomoiProject.KitPanel>
                        <MomoiProject.KitGauge name="buff-2" value="0.45" color="#96C48C" class="kit-gauge kit-gauge--thin sample-gauges-buff-bar" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sample-gauges-buff">
                        <MomoiProject.KitPanel shape="Round" pattern="None" class="sample-gauges-buff-icon kit-pn-dark kit-pn-c6"><MomoiProject.KitIcon glyph="Heart" class="sample-gauges-buff-glyph" /></MomoiProject.KitPanel>
                        <MomoiProject.KitGauge name="buff-3" value="0.2" color="#96C48C" class="kit-gauge kit-gauge--thin sample-gauges-buff-bar" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="sample-gauges-enemy">
            <ui:Label text="녹슨 수호자" class="sample-gauges-name sample-gauges-name--right" />
            <MomoiProject.KitGauge name="enemy" kind="Line" shape="Slant" frame="Inset" value="0.9" from-right="true" segments="4" color="#C86058" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-enemy-bar" />
            <ui:Label name="enemy-hint" text="" class="kit-t-heading kit-t-number sample-gauges-hint" />
        </ui:VisualElement>

        <ui:VisualElement class="sample-gauges-catalog">
            <ui:VisualElement class="sample-gauges-row">
                <ui:Label text="직선" class="sample-gauges-row-title" />
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="사각 · 꽉 채움" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Rect" frame="Flush" value="0.7" color="#C86058" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="사각 · 뒤 판 두껍게" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Rect" frame="Inset" value="0.7" color="#C86058" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="평행사변형 · 꽉 채움" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Slant" frame="Flush" value="0.7" color="#6C94D4" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="평행사변형 · 뒤 판 두껍게" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Slant" frame="Inset" value="0.7" color="#6C94D4" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sample-gauges-row">
                <ui:Label text="눈금 · 특수" class="sample-gauges-row-title" />
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="사각 · 눈금 10" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Rect" frame="Flush" value="0.6" segments="10" color="#6C94D4" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="평행사변형 · 뒤 판 두껍게 · 눈금 5" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Slant" frame="Inset" value="0.6" segments="5" color="#C86058" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="그라데이션 + 빛 번짐" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Rect" frame="Flush" value="0.6" gradient="true" glow="true" color="#D6C8B0" end-color="#FFECBE" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="평행사변형 · 그라데이션 + 빛 번짐" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Line" shape="Slant" frame="Inset" value="0.6" gradient="true" glow="true" color="#6C94D4" end-color="#96C8FF" class="kit-gauge kit-gauge--thick sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sample-gauges-row">
                <ui:Label text="원형 패널" class="sample-gauges-row-title" />
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="꽉 채움" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Orb" frame="Flush" value="0.65" color="#C86058" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="뒤 판 두껍게" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Orb" frame="Inset" value="0.65" inset="4" color="#6C94D4" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="그라데이션 + 빛 번짐" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Orb" frame="Flush" value="0.65" gradient="true" glow="true" color="#6C94D4" end-color="#96C8FF" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="뒤 판 두껍게 · 그라데이션 · 글" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Orb" frame="Inset" value="0.65" inset="4" gradient="true" text="65" color="#D6C8B0" end-color="#FFECBE" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sample-gauges-row">
                <ui:Label text="원 테두리" class="sample-gauges-row-title" />
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="꽉 채움" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Ring" frame="Flush" value="0.65" color="#C86058" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="뒤 판 두껍게" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Ring" frame="Inset" value="0.65" thickness="12" inset="3" color="#6C94D4" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="그라데이션 + 빛 번짐" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Ring" frame="Flush" value="0.65" gradient="true" glow="true" color="#D6C8B0" end-color="#FFECBE" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="뒤 판 두껍게 · 글" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Ring" frame="Inset" value="0.65" thickness="12" inset="3" text="3s" color="#96C48C" class="kit-gauge sample-gauges-demo" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sample-gauges-row">
                <ui:Label text="도형 나열" class="sample-gauges-row-title" />
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="사각 5칸" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Units" shape="Rect" frame="Flush" units="5" value="0.66" color="#C86058" class="kit-gauge sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="평행사변형 5칸 · 뒤 판 두껍게" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Units" shape="Slant" frame="Inset" units="5" value="0.66" color="#6C94D4" class="kit-gauge sample-gauges-demo sample-gauges-line" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="마름모 5칸" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Units" shape="Diamond" frame="Flush" units="5" value="0.66" color="#D6C8B0" class="kit-gauge sample-gauges-demo sample-gauges-units" /></ui:VisualElement>
                <ui:VisualElement class="sample-gauges-cell"><ui:Label text="마름모 5칸 · 뒤 판 두껍게" class="sample-gauges-caption" /><MomoiProject.KitGauge kind="Units" shape="Diamond" frame="Inset" units="5" value="0.66" inset="3" color="#96C48C" class="kit-gauge sample-gauges-demo sample-gauges-units" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="sample-gauges-load">
            <MomoiProject.KitGauge name="load" kind="Line" shape="Rect" frame="Inset" value="0" color="#F0F0F2" class="kit-gauge sample-gauges-load-bar" />
            <ui:Label name="load-text" text="0%" class="kit-t-heading kit-t-number sample-gauges-load-text" />
        </ui:VisualElement>
        <ui:VisualElement class="sample-gauges-xp">
            <ui:Label text="Lv 12" class="kit-t-heading kit-t-number sample-gauges-level" />
            <MomoiProject.KitGauge kind="Line" shape="Rect" frame="Flush" value="0.35" color="#D6C8B0" class="kit-gauge kit-gauge--thin sample-gauges-xp-bar" />
        </ui:VisualElement>
        <ui:VisualElement class="sample-gauges-controls">
            <ui:Label text="지름길(Set)" class="sample-gauges-control-title" />
            <ui:Button name="damage" text="줄이기 −15%" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="heal" text="늘리기 +15%" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Label text="찰 때 — 따로" class="sample-gauges-control-title" />
            <ui:Button name="raise" text="① 찰 몫만 띄우기 +20%" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="fill" text="② 채우기" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Label text="줄 때 — 따로" class="sample-gauges-control-title" />
            <ui:Button name="drop" text="① 깎기만 −20%" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="follow" text="② 따라 줄기" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Label text="그 밖" class="sample-gauges-control-title" />
            <ui:Button name="preview" text="잃을 몫 표시 −20%" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="loading" text="로딩" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
