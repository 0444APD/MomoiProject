<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 견본 · 게이지 타격(KitGauge.Hit — 한 번의 호출로 타격감 있게 깎기). 코드 GaugeHitSample.cs.txt.
         위 = 보스 체력 게이지(맞으면 메인이 빠르게 깎이고 · 깎인 몫이 하얗게 번쩍 · 흔들림 · 잠시 뒤 밝은 뒷 게이지가 부드럽게 따라 줆)
         + 타격 숫자(강조 숫자 kit-t-number가 펑 하고 떴다가 오르며 사라짐) + 깎인 끝 변을 따라 베기(샥 — KitFx.Slash, KitGauge.EdgeOf) · 불티 조금.
         가운데 = 다른 종류도 같은 호출(원형 패널 · 원 테두리 · 도형 나열 · 값 그라데이션).
         아래 버튼 = 약한 타격 · 강한 타격 · 연타(뒷 게이지가 첫 타 자리에 남았다가 마지막 타 뒤에 한꺼번에) · 회복 · 처음으로. -->
    <ui:VisualElement class="kit-fill sample-hit-scene" picking-mode="Ignore">
        <ui:VisualElement class="sample-hit-boss">
            <MomoiProject.KitGauge name="boss" kind="Line" shape="Slant" frame="Inset" value="1" segments="10" text="1200 / 1200" color="#C86058" class="kit-gauge kit-gauge--thick sample-hit-boss-bar" />
        </ui:VisualElement>

        <ui:VisualElement class="sample-hit-row">
            <ui:Label text="다른 종류도 같은 호출" class="sample-hit-row-title" />
            <ui:VisualElement class="sample-hit-cell"><ui:Label text="원형 패널 · 값 + 빛 번짐" class="sample-hit-caption" /><MomoiProject.KitGauge kind="Orb" frame="Inset" inset="4" value="1" gradient="ByValue" glow="true" stops="0:#C86058, 50:#E0C060, 100:#78B070" class="kit-gauge sample-hit-other" /></ui:VisualElement>
            <ui:VisualElement class="sample-hit-cell"><ui:Label text="원 테두리" class="sample-hit-caption" /><MomoiProject.KitGauge kind="Ring" frame="Inset" thickness="12" inset="3" value="1" color="#6C94D4" class="kit-gauge sample-hit-other" /></ui:VisualElement>
            <ui:VisualElement class="sample-hit-cell"><ui:Label text="도형 나열 5칸" class="sample-hit-caption" /><MomoiProject.KitGauge kind="Units" shape="Slant" frame="Inset" units="5" value="1" color="#C86058" class="kit-gauge sample-hit-other sample-hit-units" /></ui:VisualElement>
            <ui:VisualElement class="sample-hit-cell"><ui:Label text="직선 · 값 그라데이션" class="sample-hit-caption" /><MomoiProject.KitGauge kind="Line" shape="Rect" frame="Flush" value="1" gradient="ByValue" stops="0:#C86058, 50:#E0C060, 100:#78B070" class="kit-gauge kit-gauge--thick sample-hit-other sample-hit-line" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="sample-hit-controls">
            <ui:Button name="light" text="약한 타격 −70" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="heavy" text="강한 타격 −260" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="combo" text="연타 −45 × 5" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="heal" text="회복 +300" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
            <ui:Button name="reset" text="처음으로" class="kit-bt kit-bt--pill kit-bt--black kit-bt--small" />
        </ui:VisualElement>

        <ui:VisualElement name="numbers" class="kit-fill sample-hit-numbers" picking-mode="Ignore" />
        <MomoiProject.KitFx name="fx" class="kit-fx sample-hit-fx" />
    </ui:VisualElement>
</ui:UXML>
