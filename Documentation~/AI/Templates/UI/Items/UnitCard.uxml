<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 보드 유닛 카드(전투) — 140×190 검정(적은 kit-unit +enemy 붉은 면): 그림이 채우고 아래 어두운 띠에 이름 · 체력 글 · 체력 막대 · 게이지(얇게).
         상태는 면으로: +selected(아래 강조 띠) · +target(아래 붉은 띠) · +pick(대상으로 고를 수 있음 — 물든 면) · +down(옅게) · +empty(빈 칸, 띠 숨김) -->
    <ui:Button name="unit" class="kit-unit momoi-mat-cover">
        <ui:VisualElement name="art" class="kit-unit-art" picking-mode="Ignore" />
        <ui:VisualElement class="kit-unit-foot" picking-mode="Ignore">
            <ui:Label name="name" class="kit-unit-name" picking-mode="Ignore" />
            <ui:Label name="hp-text" class="kit-unit-hp" picking-mode="Ignore" />
            <ui:VisualElement class="kit-bar" picking-mode="Ignore">
                <ui:VisualElement name="hp" class="kit-bar-fill kit-bar-fill--good" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="kit-bar kit-bar--thin" picking-mode="Ignore">
                <ui:VisualElement name="gauge" class="kit-bar-fill kit-bar-fill--info" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
