<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 교환·상점 카드(176 너비): 폴더 탭(분류) · 검정 몸(이름 · 둥근 그림 · 상태 알약) · 종이 바닥(가격) -->
    <ui:Button name="offer" class="kit-offer">
        <ui:Label name="kind" class="kit-folder-tab momoi-mat-folder" picking-mode="Ignore" />
        <ui:VisualElement class="kit-offer-body momoi-mat-cover" picking-mode="Ignore">
            <ui:Label name="name" class="kit-offer-name" picking-mode="Ignore" />
            <ui:VisualElement name="art" class="kit-offer-art" picking-mode="Ignore" />
            <ui:Label name="status" class="kit-offer-status kit-pill-tag momoi-mat-paper" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="kit-offer-foot momoi-mat-paper" picking-mode="Ignore">
            <ui:Label name="price" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
