<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 세로 카드(캐릭터 명단·카드 도감 — 120×164): 그림이 채우고 아래 어두운 띠에 이름·별. 고른 카드는 kit-portrait--picked -->
    <ui:Button name="card" class="kit-portrait momoi-mat-cover">
        <ui:VisualElement name="art" class="kit-portrait-art" picking-mode="Ignore" />
        <ui:VisualElement class="kit-portrait-foot" picking-mode="Ignore">
            <ui:Label name="name" class="kit-portrait-name" picking-mode="Ignore" />
            <ui:Label name="stars" class="kit-stars" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
