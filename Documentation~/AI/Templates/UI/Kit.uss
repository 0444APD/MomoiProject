/* GBible UI 키트(AI/Templates/UI) — 범용 기능(구성 요소의 클래스)만 둔다(개발자 2026-10-13). 모양 · 색은 맨 위 변수(--kit-…)에서 언제든 바꾼다. 견본 화면 전용 모양은 Samples/Samples.uss.
   프로젝트의 Assets/MomoiProject/UI/Kit/Kit.uss로 복사하고, 프로젝트 화면 USS 첫 줄에서 @import url("../Kit/Kit.uss");
   패널 면은 코드 KitPanel(단색 + 아주 옅은 조각)이 그린다 — 색 · 둥글기는 아래 kit-pn-* 클래스의 커스텀 속성(단위 없는 숫자).
   1920×1080 기준 px · 간격은 4의 배수 · 글은 6단계 · 선은 1px(굵게) · 0.5px(얇게). 움직임은 GBible(ScreenMotion · momoi-motion)이 맡는다. */

/* ── 색 변수: 키트의 모양 · 색은 여기서만 바꾼다(프로젝트 테마나 이 블록). 화면 USS는 var(--kit-…)로 쓴다 ── */
:root {
    /* 면 */
    --kit-dark: rgb(40, 41, 46);             /* 검정 판 · 메뉴 막대 · 제목 막대 */
    --kit-black: rgb(34, 35, 40);            /* 검정 버튼 · 원 버튼 */
    --kit-black-hover: rgb(56, 58, 64);
    --kit-paper: rgb(244, 242, 238);         /* 종이 판 */
    --kit-white: rgb(247, 245, 241);         /* 흰 버튼 · 메뉴의 흰 안쪽 판 */
    --kit-white-hover: rgb(255, 255, 255);
    --kit-gray: rgb(222, 220, 214);          /* 회색 판 · UI 배경 */
    --kit-stone: rgb(62, 64, 70);            /* 숯색 돌 판 · 칸 */
    --kit-sand: rgb(214, 200, 176);          /* 강조(기본 UI의 노란색) — 모래색 버튼 */
    --kit-sand-hover: rgb(228, 216, 194);
    --kit-sand-ink: rgb(40, 34, 26);         /* 모래색 위 글 */
    --kit-sand-panel: rgb(206, 192, 170);    /* 모래색 판 · 작은 표시 */
    --kit-off: rgb(214, 212, 207);           /* 끔(비활성) */
    --kit-off-ink: rgb(150, 148, 142);
    --kit-slot: rgb(228, 226, 221);          /* 종이 판 위 칸 */
    --kit-slot-dark: rgb(54, 56, 62);        /* 검정 판 위 칸 */
    /* 글 */
    --kit-ink: rgb(36, 36, 40);              /* 종이 위 글 */
    --kit-light: rgb(240, 240, 242);         /* 검정 위 글 */
    --kit-dim: rgb(170, 172, 180);           /* 흐린 글(검정 위) */
    --kit-label: rgb(140, 136, 128);         /* 꼬리표(종이 위) */
    --kit-up: rgb(70, 120, 76);              /* 오른 값(종이 위) */
    --kit-up-dark: rgb(132, 190, 136);       /* 오른 값(검정 위) */
    /* 선(라인 디자인 · 선 포인트) */
    --kit-line-dark: rgba(206, 206, 212, 0.78);
    --kit-line-paper: rgba(40, 41, 46, 0.7);
    --kit-line-scene: rgba(222, 222, 228, 0.7);
    --kit-accent-dark: rgba(214, 200, 176, 0.9);
    --kit-accent-dark-thin: rgba(214, 200, 176, 0.8);
    --kit-accent-paper: rgba(40, 41, 46, 0.8);
    /* 순간 연출(KitFx · KitGlow · KitSheen) — 빛 색(기본 따뜻한 금빛, 개발자 2026-10-13) */
    --kit-fx-core: rgb(255, 242, 217);       /* 불티의 밝은 쪽 · 빛 고리 */
    --kit-fx-color: rgb(255, 214, 140);      /* 불티의 색 쪽 */
    --kit-fx-rays: rgba(255, 219, 153, 0.32);
    --kit-fx-glow: rgb(255, 214, 140);       /* 빛 번짐(묶음 연출의 기본) */
    --kit-sheen: rgba(255, 244, 220, 0.42);  /* 훑는 빛 */
    /* 막대(KitBar — 체력 · 마나 · 경험치 · 로딩 · 버프 지속, 개발자 2026-10-15) */
    --kit-bar-track: rgba(18, 19, 22, 0.62);     /* 빈 자리(장면 위에서도 보이게 반투명 검정) */
    --kit-bar-hp: rgb(200, 96, 88);
    --kit-bar-mp: rgb(108, 148, 212);
    --kit-bar-xp: rgb(214, 200, 176);
    --kit-bar-load: rgb(240, 240, 242);
    --kit-bar-buff: rgb(150, 196, 140);
    --kit-bar-trail: rgba(255, 244, 228, 0.8);   /* 줄 때 남는 자국 */
    --kit-bar-loss: rgba(255, 255, 255, 0.55);   /* 예상 — 잃을 양 */
    --kit-bar-gain: rgba(150, 214, 150, 0.7);    /* 예상 — 얻을 양 */
    --kit-bar-tick: rgba(0, 0, 0, 0.4);          /* 칸 나눔 눈금 */
}

/* ── 글 단계(UiGuide 2-4) ── */
.kit-t-display { font-size: 44px; -unity-font-style: bold; }
.kit-t-title { font-size: 28px; -unity-font-style: bold; }
.kit-t-heading { font-size: 20px; -unity-font-style: bold; }
.kit-t-body { font-size: 16px; white-space: normal; }
.kit-t-small { font-size: 14px; white-space: normal; }
.kit-t-caption { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; }

/* ── 패널 색(KitPanel이 읽는다). 조각 명암 차 기본 0.009(패널) · 0.005(UI 배경 — kit-pn-faint) · 최대 0.014 ── */
.kit-pn-dark { --panel-fill: var(--kit-dark); --panel-shard: 0.009; color: var(--kit-light); }
.kit-pn-paper { --panel-fill: var(--kit-paper); --panel-shard: 0.009; color: var(--kit-ink); }
.kit-pn-gray { --panel-fill: var(--kit-gray); --panel-shard: 0.009; color: rgb(44, 44, 48); }
.kit-pn-stone { --panel-fill: var(--kit-stone); --panel-shard: 0.009; color: rgb(228, 230, 234); }
.kit-pn-sand { --panel-fill: var(--kit-sand-panel); --panel-shard: 0.009; color: rgb(48, 40, 30); }
.kit-pn-max { --panel-shard: 0.014; }
.kit-pn-faint { --panel-shard: 0.005; }
.kit-pn-flat { --panel-shard: 0; }
.kit-pn-c6 { --panel-corner: 6; }
.kit-pn-c12 { --panel-corner: 12; }
.kit-pn-c18 { --panel-corner: 18; }
.kit-pn-c28 { --panel-corner: 28; }
.kit-pn-line-light { --panel-line: rgba(255, 255, 255, 0.22); }
.kit-pn-line-dark { --panel-line: rgba(0, 0, 0, 0.16); }
.kit-pn-gap6 { --panel-line-gap: 6; }

/* ── 바탕 ── */
.kit-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.kit-center { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }

/* ── 라인 디자인(KitOutline — 요소 규격) · 선 포인트(KitAccent) · 나누는 선 · 반짝임. 색은 판에 맞춘다 ── */
.kit-outline { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.kit-ol-on-dark { --outline-color: var(--kit-line-dark); --outline-strong: 1; --outline-light: 0.5; }
.kit-ol-on-paper { --outline-color: var(--kit-line-paper); --outline-strong: 1; --outline-light: 0.5; }
.kit-ol-on-scene { --outline-color: var(--kit-line-scene); --outline-strong: 1; --outline-light: 0.5; }
.kit-ol-block { flex-shrink: 0; }   /* 라인 디자인이 둘레 8px를 비켜 가는 칸(KitOutline이 이 클래스로 찾는다) */
.kit-accent { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.kit-ac-on-dark { --accent-color: var(--kit-accent-dark); --accent-thin: var(--kit-accent-dark-thin); --accent-width: 1; --accent-thin-width: 0.5; }
.kit-ac-on-paper { --accent-color: var(--kit-accent-paper); --accent-thin: var(--kit-line-paper); --accent-width: 1; --accent-thin-width: 0.5; }
.kit-spark { width: 14px; height: 14px; --spark-color: rgba(0, 0, 0, 0.5); }
.kit-icon { width: 24px; height: 24px; }

/* ── 화면 머리(UI 배경 위): 집 · 화면 이름 · 재화 · 뒤로 ── */
.kit-head { position: absolute; left: 48px; top: 28px; flex-direction: row; align-items: center; }
.kit-head-home { width: 56px; height: 56px; border-radius: 28px; background-color: var(--kit-black); align-items: center; justify-content: center; }
.kit-head-home-mark { width: 22px; height: 22px; --spark-color: rgba(255, 255, 255, 0.85); }
.kit-head-title { margin-left: 16px; font-size: 22px; -unity-font-style: bold; color: var(--kit-ink); }
.kit-head-back { position: absolute; right: 48px; top: 32px; width: 48px; height: 48px; border-radius: 24px; background-color: var(--kit-black); }
.kit-money { height: 40px; min-width: 200px; padding: 0 16px 0 4px; border-radius: 20px; background-color: var(--kit-dark); flex-direction: row; align-items: center; }
.kit-money-icon { width: 32px; height: 32px; border-radius: 16px; background-color: var(--kit-sand-panel); }
.kit-money-value { flex-grow: 1; color: var(--kit-light); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-right; }

/* ── 왼쪽 세로 목록(UI 배경 위) — 고른 것에만 판 ── */
.kit-nav { position: absolute; left: 0; top: 150px; width: 340px; }
.kit-nav-item { height: 48px; flex-direction: row; align-items: center; padding-left: 72px; }
.kit-nav-dot { width: 6px; height: 6px; border-radius: 3px; background-color: rgb(60, 60, 66); margin-right: 16px; }
.kit-nav-text { font-size: 18px; color: rgb(60, 60, 66); }
.kit-nav-item--on { height: 48px; padding-left: 64px; margin: 4px 0; flex-direction: row; align-items: center; }
.kit-nav-item--on .kit-nav-text { color: var(--kit-light); -unity-font-style: bold; }
.kit-nav-spark { width: 14px; height: 14px; margin-right: 12px; --spark-color: var(--kit-light); }

/* ── 정보 정리(팝업 · 상세 안): 머리(꼬리표 · 제목 | 등급) → 줄 → 몸(그림 | 스탯) → 설명 → 꼬리표 ── */
.kit-info-head { flex-direction: row; align-items: flex-start; }
.kit-info-head-text { flex-grow: 1; }
.kit-info-eyebrow { margin-bottom: 8px; color: var(--kit-label); }
.kit-info-badge { height: 26px; margin-top: 2px; padding: 0 12px; border-radius: 13px; background-color: rgb(30, 31, 35); color: rgb(150, 182, 232); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
.kit-info-rule { height: 4px; margin: 16px 0 16px 0; --rule-color: rgba(0, 0, 0, 0.32); }
.kit-info-main { flex-direction: row; }
.kit-info-art { width: 152px; height: 152px; border-radius: 6px; background-color: rgb(48, 49, 55); align-items: center; justify-content: center; }
.kit-info-art-mark { width: 44px; height: 44px; --spark-color: rgba(255, 255, 255, 0.24); }
.kit-info-side { flex-grow: 1; margin-left: 24px; }
.kit-info-label { height: 28px; padding-left: 12px; margin-bottom: 8px; background-color: rgb(30, 31, 35); color: var(--kit-light); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-left; }
.kit-info-stats { padding: 4px 16px; --panel-fill: rgb(234, 231, 224); --panel-shard: 0; --panel-corner: 6; }
.kit-info-stat { height: 32px; flex-direction: row; justify-content: space-between; align-items: center; border-bottom-width: 1px; border-color: rgba(0, 0, 0, 0.07); }
.kit-info-stat--last { border-bottom-width: 0; }
.kit-info-stat-name { font-size: 15px; color: rgb(98, 96, 92); }
.kit-info-stat-value { font-size: 16px; -unity-font-style: bold; }
.kit-info-up { color: var(--kit-up); }
.kit-info-desc { margin-top: 20px; color: rgb(58, 57, 56); }
.kit-info-tags { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.kit-tag { height: 26px; margin: 0 8px 8px 0; padding: 0 12px; border-radius: 13px; background-color: rgba(0, 0, 0, 0.07); color: rgb(80, 78, 74); font-size: 13px; -unity-text-align: middle-center; }
.kit-tag--on { background-color: var(--kit-dark); color: var(--kit-light); }
/* 검정 판 위에 바로 놓일 때 */
.kit-on-dark .kit-info-eyebrow { color: rgb(150, 152, 160); }
.kit-on-dark .kit-info-rule { --rule-color: rgba(255, 255, 255, 0.32); }
.kit-on-dark .kit-info-art { background-color: rgb(24, 25, 29); }
.kit-on-dark .kit-info-label { background-color: rgb(232, 229, 222); color: rgb(30, 31, 35); }
.kit-on-dark .kit-info-stats { --panel-fill: rgb(54, 55, 61); }
.kit-on-dark .kit-info-stat { border-color: rgba(255, 255, 255, 0.08); }
.kit-on-dark .kit-info-stat-name { color: rgb(172, 174, 182); }
.kit-on-dark .kit-info-up { color: var(--kit-up-dark); }
.kit-on-dark .kit-info-desc { color: rgb(220, 222, 226); }
.kit-on-dark .kit-tag { background-color: rgba(255, 255, 255, 0.09); color: rgb(212, 214, 220); }
.kit-on-dark .kit-info-badge { background-color: rgb(232, 229, 222); color: rgb(64, 96, 160); }
/* 틀(A) 안에 안판(B)이 이미 있으면 스탯 상자는 판으로 그리지 않는다 — 3중첩 금지 */
.kit-no-third .kit-info-stats { --panel-fill: rgba(0, 0, 0, 0); padding: 0; }

/* ── 버튼(요소 규격): 흰색 · 모래색(기본 UI의 노란색) · 검정 · 끔(옅은 회색) × 동글이 · 알약 · 네모 · 변칙(자름 · 잎).
      판과 같은 색의 면 버튼 대신 반전색 아웃라인(두 겹 — 바깥 1px · 안쪽 0.5px)이나 글자만. 변칙은 한 화면에 한 가지.
      올림 = 면 색만 0.08초 · 누름 = 0.97배로 0.06초(놓으면 0.1초). 판 맥락 클래스 kit-on-paper · kit-on-dark가 아웃라인 · 글자만의 색을 정한다 ── */
.kit-bt-row { flex-direction: row; justify-content: flex-end; align-items: center; }
.kit-bt { height: 40px; min-width: 140px; margin: 0 0 0 8px; padding: 0 24px; border-width: 0; font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; transition-property: background-color, scale; transition-duration: 0.08s, 0.1s; transition-timing-function: ease-out-cubic, ease-out-cubic; }
.kit-bt:active { scale: 0.97 0.97; transition-duration: 0.08s, 0.06s; }
.kit-bt--pill { border-radius: 20px; }
.kit-bt--square { border-radius: 0; }
.kit-bt--circle { width: 44px; height: 44px; min-width: 44px; padding: 0; border-radius: 22px; align-items: center; justify-content: center; }
.kit-bt--cut, .kit-bt--leaf { height: 42px; padding: 0; align-items: center; justify-content: center; }
.kit-bt-face { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.kit-bt--cut .kit-bt-face { --panel-corner: 10; }
.kit-bt--leaf .kit-bt-face { --panel-corner: 16; }
.kit-bt-text { margin: 0; padding: 0 24px; font-size: 15px; -unity-font-style: bold; }
.kit-bt-mark { width: 16px; height: 16px; }
.kit-bt--small { height: 30px; min-width: 80px; padding: 0 16px; font-size: 13px; }
.kit-bt--small.kit-bt--pill { border-radius: 15px; }
.kit-bt--small.kit-bt--circle { width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 14px; }
.kit-bt--small.kit-bt--cut, .kit-bt--small.kit-bt--leaf { height: 30px; padding: 0; }
.kit-bt--small .kit-bt-text { padding: 0 16px; font-size: 13px; }
.kit-bt--small.kit-bt--cut .kit-bt-face { --panel-corner: 7; }
.kit-bt--small.kit-bt--leaf .kit-bt-face { --panel-corner: 11; }
.kit-bt--small .kit-bt-mark { width: 12px; height: 12px; }
/* 면이 그림(KitPanel)인 버튼 · 아웃라인 · 글자만은 버튼 바탕을 비운다 */
.kit-bt.kit-bt--cut, .kit-bt.kit-bt--leaf, .kit-bt.kit-bt--line, .kit-bt.kit-bt--text,
.kit-bt.kit-bt--cut:hover, .kit-bt.kit-bt--leaf:hover, .kit-bt.kit-bt--line:hover, .kit-bt.kit-bt--text:hover,
.kit-bt.kit-bt--cut:active, .kit-bt.kit-bt--leaf:active, .kit-bt.kit-bt--line:active, .kit-bt.kit-bt--text:active,
.kit-bt.kit-bt--cut:hover:active, .kit-bt.kit-bt--leaf:hover:active, .kit-bt.kit-bt--line:hover:active, .kit-bt.kit-bt--text:hover:active { background-color: rgba(0, 0, 0, 0); }
.kit-bt--line, .kit-bt--text { padding: 0; align-items: center; justify-content: center; }
/* 색 */
.kit-bt--white { background-color: var(--kit-white); color: var(--kit-ink); }
.kit-bt--white:hover, .kit-bt--white:active, .kit-bt--white:hover:active { background-color: var(--kit-white-hover); }
.kit-bt--white .kit-bt-face { --panel-fill: var(--kit-white); }
.kit-bt--white:hover .kit-bt-face { --panel-fill: var(--kit-white-hover); }
.kit-bt--white .kit-bt-text { color: var(--kit-ink); }
.kit-bt--white .kit-bt-mark { --spark-color: rgba(36, 36, 40, 0.6); }
.kit-bt--sand { background-color: var(--kit-sand); color: var(--kit-sand-ink); }
.kit-bt--sand:hover, .kit-bt--sand:active, .kit-bt--sand:hover:active { background-color: var(--kit-sand-hover); }
.kit-bt--sand .kit-bt-face { --panel-fill: var(--kit-sand); }
.kit-bt--sand:hover .kit-bt-face { --panel-fill: var(--kit-sand-hover); }
.kit-bt--sand .kit-bt-text { color: var(--kit-sand-ink); }
.kit-bt--sand .kit-bt-mark { --spark-color: rgba(40, 34, 26, 0.55); }
.kit-bt--black { background-color: var(--kit-black); color: var(--kit-light); }
.kit-bt--black:hover, .kit-bt--black:active, .kit-bt--black:hover:active { background-color: var(--kit-black-hover); }
.kit-bt--black .kit-bt-face { --panel-fill: var(--kit-black); }
.kit-bt--black:hover .kit-bt-face { --panel-fill: var(--kit-black-hover); }
.kit-bt--black .kit-bt-text { color: var(--kit-light); }
.kit-bt--black .kit-bt-mark { --spark-color: rgba(255, 255, 255, 0.7); }
.kit-bt--off, .kit-bt--off:hover, .kit-bt--off:active, .kit-bt--off:hover:active { background-color: var(--kit-off); color: var(--kit-off-ink); }
.kit-bt.kit-bt--off:active { scale: 1 1; }
.kit-bt--off .kit-bt-face, .kit-bt--off:hover .kit-bt-face { --panel-fill: var(--kit-off); }
.kit-bt--off .kit-bt-text { color: var(--kit-off-ink); }
.kit-bt--off .kit-bt-mark { --spark-color: rgba(0, 0, 0, 0.22); }
/* 반전색 아웃라인(KitPanel line="Double") · 글자만 — 판과 반대 색, 올리면 아주 옅게 물든다 */
.kit-bt--line .kit-bt-face { --panel-line-width: 1; --panel-line-inner: 0.5; --panel-line-gap: 3; }
.kit-bt--small.kit-bt--line .kit-bt-face { --panel-line-gap: 2.5; }
.kit-on-paper .kit-bt--line .kit-bt-face, .kit-on-paper .kit-bt--text .kit-bt-face { --panel-fill: rgba(36, 36, 40, 0); --panel-line: var(--kit-ink); }
.kit-on-paper .kit-bt--line:hover .kit-bt-face, .kit-on-paper .kit-bt--text:hover .kit-bt-face { --panel-fill: rgba(36, 36, 40, 0.07); }
.kit-on-paper .kit-bt--line .kit-bt-text, .kit-on-paper .kit-bt--text .kit-bt-text { color: var(--kit-ink); }
.kit-on-paper .kit-bt--line .kit-bt-mark, .kit-on-paper .kit-bt--text .kit-bt-mark { --spark-color: rgba(36, 36, 40, 0.75); }
.kit-on-dark .kit-bt--line .kit-bt-face, .kit-on-dark .kit-bt--text .kit-bt-face { --panel-fill: rgba(255, 255, 255, 0); --panel-line: var(--kit-light); }
.kit-on-dark .kit-bt--line:hover .kit-bt-face, .kit-on-dark .kit-bt--text:hover .kit-bt-face { --panel-fill: rgba(255, 255, 255, 0.08); }
.kit-on-dark .kit-bt--line .kit-bt-text, .kit-on-dark .kit-bt--text .kit-bt-text { color: var(--kit-light); }
.kit-on-dark .kit-bt--line .kit-bt-mark, .kit-on-dark .kit-bt--text .kit-bt-mark { --spark-color: rgba(255, 255, 255, 0.8); }

/* ── 가로 메뉴(토글) — 프로젝트마다 한 방식으로 고정, 기본 B3: 긴 막대(KitPanel) + 고른 것만 흰 안쪽 판(KitPanel). 변칙은 막대 · 안쪽 판에도 같게 ── */
.kit-menu { height: 44px; padding: 0 4px; flex-direction: row; align-items: center; align-self: flex-start; --panel-fill: var(--kit-dark); --panel-shard: 0; --panel-corner: 12; }
.kit-menu-item { height: 36px; margin: 0; padding: 0 20px; border-width: 0; background-color: rgba(0, 0, 0, 0); font-size: 15px; color: var(--kit-dim); -unity-text-align: middle-center; }
.kit-menu-on { height: 36px; justify-content: center; --panel-fill: var(--kit-white); --panel-shard: 0; --panel-corner: 10; }
.kit-menu-on .kit-menu-item { color: var(--kit-ink); -unity-font-style: bold; }
/* ── 제목 막대(KitPanel — 변칙은 그 화면의 것) ── */
.kit-titlebar { height: 56px; padding: 0 24px; flex-direction: row; align-items: center; justify-content: space-between; --panel-fill: var(--kit-dark); --panel-shard: 0; --panel-corner: 14; }
.kit-titlebar-text { margin: 0; padding: 0; font-size: 20px; -unity-font-style: bold; color: var(--kit-light); }
.kit-titlebar-count { margin: 0; padding: 0; font-size: 14px; color: var(--kit-dim); }

/* ── 칸(여럿 늘어서는 요소 — 베젤 없는 판, 중첩 · 선 최소, 라인 디자인 없음) ── */
.kit-slot { width: 88px; height: 88px; margin: 0 16px 16px 0; border-radius: 6px; background-color: var(--kit-slot); align-items: center; justify-content: center; }
.kit-on-dark .kit-slot { background-color: var(--kit-slot-dark); }
.kit-slot-mark { width: 18px; height: 18px; --spark-color: rgba(0, 0, 0, 0.2); }
.kit-on-dark .kit-slot-mark { --spark-color: rgba(255, 255, 255, 0.3); }
/* 그림 + 이름 칸(KitPanel pattern="None") */
.kit-card { width: 132px; height: 160px; margin: 0 8px 8px 0; padding: 12px 8px; align-items: center; color: rgb(228, 230, 234); --panel-fill: var(--kit-stone); --panel-shard: 0; --panel-corner: 6; }
.kit-card--on { --panel-fill: var(--kit-sand); color: var(--kit-sand-ink); }
.kit-card--empty { --panel-fill: rgba(0, 0, 0, 0.06); }
.kit-card-art { width: 88px; height: 88px; border-radius: 6px; background-color: rgb(28, 29, 33); align-items: center; justify-content: center; }
.kit-card-mark { width: 32px; height: 32px; --spark-color: rgba(255, 255, 255, 0.3); }
.kit-card-name { margin-top: 12px; font-size: 13px; -unity-font-style: bold; }

/* ── 상세 틀: 검정 틀(A) + 머리 띠(안판이 없는 자리에만 선) + 종이 안판(B) + 버튼 줄 ── */
.kit-frame { padding: 12px; }
.kit-frame-head { height: 44px; flex-direction: row; align-items: center; padding: 0 12px 0 16px; }
.kit-frame-spark { width: 14px; height: 14px; --spark-color: var(--kit-sand-panel); }
.kit-frame-title { margin-left: 12px; font-size: 18px; -unity-font-style: bold; }
.kit-frame-rule { flex-grow: 1; height: 4px; margin: 0 16px; --rule-color: rgba(214, 200, 176, 0.75); --rule-width: 1; }
.kit-frame-count { font-size: 13px; color: rgb(150, 152, 160); -unity-text-align: middle-right; }
.kit-frame-inner { flex-grow: 1; padding: 24px 28px; }
.kit-frame-foot { flex-direction: row; justify-content: flex-end; padding: 12px 4px 0 4px; }

/* ── 순간 연출: 연출 층(KitFx — 화면 맨 위에 깐다)과 훑는 빛(KitSheen — 카드 안에 깐다, 카드에 overflow: hidden). 색은 위 변수 ── */
.kit-fx { position: absolute; left: 0; top: 0; right: 0; bottom: 0; filter: drop-shadow(0px 0px 6px rgba(255, 214, 140, 0.85)); --fx-core: var(--kit-fx-core); --fx-color: var(--kit-fx-color); --fx-ring: var(--kit-fx-core); --fx-rays: var(--kit-fx-rays); --fx-glow: var(--kit-fx-glow); }   /* filter의 빛 색은 변수가 닿지 않아 여기서 함께 바꾼다 */
.kit-sheen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; --sheen-color: var(--kit-sheen); }

/* ── 막대(KitBar): 체력 · 마나 · 경험치 · 로딩 · 버프 지속은 이 하나로(개발자 2026-10-15). 장면 위에 판 없이 놓는다(UiGuide 3-1).
   굵기 = 기본 12 · --thin 6 · --thick 20, 모양 = 기본 알약 · --square 직각, 색 = --hp · --mp · --xp · --load · --buff(위 변수). 채움 · 자국 · 예상은 막대 모양을 따라 잘린다 ── */
.kit-bar { height: 12px; min-width: 40px; overflow: hidden; border-radius: 6px; background-color: var(--kit-bar-track); --bar-tick: var(--kit-bar-tick); }
.kit-bar--thin { height: 6px; border-radius: 3px; }
.kit-bar--thick { height: 20px; border-radius: 10px; }
.kit-bar--square { border-radius: 0; }
.kit-bar-fill, .kit-bar-trail, .kit-bar-preview { position: absolute; top: 0; bottom: 0; }
.kit-bar-fill { background-color: var(--kit-bar-hp); }
.kit-bar-trail { background-color: var(--kit-bar-trail); }
.kit-bar-preview--loss { background-color: var(--kit-bar-loss); }
.kit-bar-preview--gain { background-color: var(--kit-bar-gain); }
.kit-bar-ticks { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.kit-bar-text { position: absolute; left: 0; top: 0; right: 0; bottom: 0; margin: 0; padding: 0; -unity-text-align: middle-center; font-size: 13px; -unity-font-style: bold; color: var(--kit-light); }
.kit-bar--hp .kit-bar-fill { background-color: var(--kit-bar-hp); }
.kit-bar--mp .kit-bar-fill { background-color: var(--kit-bar-mp); }
.kit-bar--xp .kit-bar-fill { background-color: var(--kit-bar-xp); }
.kit-bar--load .kit-bar-fill { background-color: var(--kit-bar-load); }
.kit-bar--buff .kit-bar-fill { background-color: var(--kit-bar-buff); }
