<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 확인용 HUD(DB › 화면 checkHud). binding-path는 코드 없이 값을 보이고, 버튼·목록은 CheckHud(GameScreen)가 잇는다. -->
    <ui:Template name="CheckUnitItem" src="CheckUnitItem.uxml" />
    <ui:VisualElement name="check-hud" style="position: absolute; left: 24px; top: 24px; width: 560px; padding: 16px; background-color: rgba(20, 24, 34, 0.9); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
        <ui:Label text="확인용 HUD (DB › 화면 checkHud)" style="-unity-font-style: bold; font-size: 24px; margin-bottom: 8px;" />
        <ui:Label binding-path="checkRun:turn" text="턴 {value}" />
        <ui:Label binding-path="checkRun:energy" text="에너지 {value} / 3" />
        <ui:Label binding-path="checkRun:kept" text="가진 전리품 {value}개" />
        <ui:VisualElement name="units" style="margin-top: 8px; margin-bottom: 8px;" />
        <ui:VisualElement style="flex-direction: row; flex-wrap: wrap;">
            <ui:Button name="hit" text="적 때리기" class="momoi-button" />
            <ui:Button name="pay-hit" text="에너지 2로 때리기" class="momoi-button" />
            <ui:Button name="end-turn" text="턴 끝" class="momoi-button" />
            <ui:Button name="ask" text="고르기 요구" class="momoi-button" />
            <ui:Button name="settings" text="설정" class="momoi-button" />
            <ui:Button name="close" text="닫기" class="momoi-button momoi-button--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
